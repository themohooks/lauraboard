// Data contract of the scenes screen (src/bridge/scenes): scenes are
// library items composed on air — a background with music by rules; the
// screen graphics show over them by graphics rules.

export struct SceneItemRow {
    id: string,
    title: string,
    // "00:01:00 · фон: цвет · музыка: 2 правила"
    detail: string,
    problem: string,
}

export struct TrackRow {
    id: string,
    title: string,
    duration: string,
}

export struct MusicRow {
    index: int,
    name: string,
    enabled: bool,
    tracks: [TrackRow],
    folder: string,
    category: string,
    // 0 по порядку, 1 перемешать, 2 один случайный трек
    order: int,
    volume: string,
    fade-in: string,
    fade-out: string,
    random-start: bool,
    // 0 по кругу до конца сцены, 1 один раз, 2 несколько раз
    repeat-mode: int,
    repeat-times: string,
    gap: string,
    delay: string,
    // "Музыка длится 00:04:12, сцена — 00:05:00" / ""
    length: string,
    // the music has a known length different from the scene's
    can-fit: bool,
    from: string,
    to: string,
    // Mon..Sun
    days: [bool],
    // "3 трека · 00:12:40" / "нет треков"
    summary: string,
}

// A rule of the channel graphics limited to the scene (the way scenes
// had graphics before they got their own).
export struct SceneGfxRow {
    index: int,
    name: string,
    element: string,
    enabled: bool,
}

export global Scenes {
    // 0 scenes, 1 insertion rules of scenes, 2 gap filling
    in-out property <int> tab;
    callback tab-changed(int);
    in property <[SceneItemRow]> rows;
    in property <int> selected: -1;
    in property <bool> dirty;
    // the form: the selected scene's draft
    in-out property <string> f-title;
    in property <string> f-id;
    in-out property <int> f-kind;
    in-out property <string> f-category;
    in-out property <string> f-duration;
    in property <string> e-duration;
    // background: 0 colour, 1 library item
    in-out property <int> f-bg-type;
    in-out property <string> f-bg-color;
    in property <color> sw-bg-color;
    in property <string> f-bg-media;
    in property <image> bg-thumb;
    in property <bool> has-bg-thumb;
    in property <[MusicRow]> music;
    in property <[SceneGfxRow]> gfx;
    // "Своя графика: элементов — 2, правил показа — 2."
    in property <string> gfx-summary;
    // the channel graphics (logo, ticker) show over the scene
    in property <bool> gfx-channel: true;
    in property <[string]> folder-options;

    callback select(int);
    // template: "empty", "clock", "music", "next"
    callback create(string);
    callback duplicate();
    callback remove();
    callback form-changed();
    callback bg-pick();
    callback music-add();
    callback music-remove(int);
    callback music-move(int, int);
    // rule index, field, value
    callback music-edited(int, string, string);
    callback music-pick(int);
    callback music-track-remove(int, int);
    // the scene's duration := the music's length (rule index)
    callback music-fit(int);
    callback gfx-channel-toggled(bool);
    callback gfx-toggle(int);
    callback gfx-remove(int);
    // the graphics editor with this scene as the scope
    callback open-graphics();
    callback save();
    callback revert();
    // on air: "play" now, "queue" after the current item
    callback air(string);
}
