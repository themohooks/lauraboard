// Data contract of the sources & scenes overview (src/bridge/sources.rs).

export struct SceneRow {
    // -1 = automatic (by the weekly plan)
    index: int,
    name: string,
    detail: string,
    active: bool,
    enabled: bool,
}

export struct OutRow {
    // index in the channel's output list
    index: int,
    name: string,
    // secrets masked
    url: string,
    format: string,
    enabled: bool,
}

export struct StreamRow {
    index: int,
    title: string,
    url: string,
    enabled: bool,
}

export struct Fact {
    label: string,
    value: string,
}

export global Src {
    in property <[SceneRow]> scenes;
    in property <bool> manual;

    // encoder / output state (from the live status)
    in property <bool> running;
    in property <string> state-text;
    in property <[Fact]> encoder;
    in property <string> last-error;
    in property <[string]> active-targets;

    // channel settings (admin role only)
    in property <bool> has-config;
    in property <[Fact]> format;
    in property <[OutRow]> outputs;
    in property <[Fact]> recording;

    in property <[StreamRow]> streams;

    callback switch-scene(int);
    callback open-library();

    // output targets (admin): edit opens the dialog, index -1 = new
    callback output-edit(int);
    callback output-toggle(int);
    callback output-remove(int);
    // live stream inputs (library items of kind "stream")
    callback stream-edit(int);
    callback stream-toggle(int);
    callback stream-remove(int);
    // "queue" or "now"
    callback stream-air(int, string);

    // edit dialog: "output" / "stream" ("" = closed)
    in-out property <string> dialog;
    in property <bool> dialog-new;
    in-out property <string> e-name;
    in-out property <string> e-url;
    // stream key, appended to the URL as the last path segment
    in-out property <string> e-key;
    // 0 auto, 1 flv, 2 mpegts, 3 hls
    in-out property <int> e-format;
    in-out property <string> e-duration;
    in property <string> e-error;
    callback dialog-save();

    // encoder settings dialog (dialog == "encoder"); selects are indexes
    // into the option lists below, filled from Rust
    in property <[string]> k-codecs;
    in property <[string]> k-presets;
    in property <[string]> k-tunes;
    in property <[string]> k-profiles;
    in property <[string]> k-pix-fmts;
    in property <[string]> k-acodecs;
    in-out property <int> k-codec;
    in-out property <int> k-preset;
    in-out property <int> k-profile;
    in-out property <string> k-level;
    in-out property <int> k-tune;
    // 0 CBR, 1 VBR, 2 constant quality
    in-out property <int> k-rc;
    in-out property <string> k-bitrate;
    in-out property <string> k-maxrate;
    in-out property <string> k-bufsize;
    in-out property <float> k-crf: 23;
    in-out property <string> k-gop;
    in-out property <string> k-bframes;
    in-out property <bool> k-scene-cut;
    in-out property <string> k-threads;
    in-out property <int> k-pix-fmt;
    in-out property <string> k-width;
    in-out property <string> k-height;
    in-out property <string> k-fps;
    in-out property <int> k-acodec;
    in-out property <string> k-abitrate;
    // 0 44.1 kHz, 1 48 kHz
    in-out property <int> k-rate;
    // 0 mono, 1 stereo, 2 5.1
    in-out property <int> k-channels;
    in-out property <string> k-volume;
    in-out property <bool> k-normalize;
    in-out property <string> k-extra;
    // x264 / x265: tune applies
    in property <bool> k-has-tune;
    in property <string> k-error;
    callback encoder-edit();
    callback encoder-codec-changed();
    callback encoder-save();
}
