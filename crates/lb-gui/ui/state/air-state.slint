// Data contract of the Home and On-Air screens (filled by src/bridge/air.rs).

import { MenuEntry } from "../components/menu.slint";

export struct NowInfo {
    has-item: bool,
    title: string,
    kind: string,
    block: string,
    elapsed: string,
    remaining: string,
    duration: string,
    progress: float,
    deviation: string,
    deviation-warn: bool,
    started: string,
    ends: string,
    // can be rewound (not a stream / still image / slate)
    seekable: bool,
    duration-s: int,
}

export struct NextInfo {
    has-item: bool,
    title: string,
    kind: string,
    start: string,
    duration: string,
    media: string,
    program-title: string,
    program-start: string,
    program-in: string,
}

// One row of the queue / rundown.
export struct QueueRow {
    uid: string,
    start: string,
    end: string,
    duration: string,
    title: string,
    kind: string,
    block: string,
    note: string,
    // block boundary: first item of a new block
    block-start: bool,
    current: bool,
    next: bool,
    main: bool,
}

export struct MediaPick {
    id: string,
    title: string,
    kind: string,
    duration: string,
}

export struct GfxRow {
    id: string,
    name: string,
    kind: string,
    layer: string,
    on: bool,
}

export struct LogRow {
    at: string,
    // info / warning / critical
    level: string,
    text: string,
}

export global Air {
    in-out property <bool> detail-open;
    in property <string> detail-title;
    in property <string> detail-text;
    callback inspect-queue(string);
    in property <NowInfo> now;
    in property <NextInfo> next;
    in property <image> next-thumb;
    in property <bool> has-next-thumb;
    in property <[QueueRow]> queue;
    in property <string> queue-summary;
    in property <[string]> warnings;

    // quick actions
    in-out property <string> media-filter;
    in property <[MediaPick]> media-results;
    in property <[string]> ad-breaks;
    in property <[string]> schedules;
    in property <int> schedule-index;
    in property <[GfxRow]> graphics;
    in-out property <string> ticker;
    in-out property <int> quick-tab: 0;
    // ⋮ menu dialog: 0 closed, 1 ad break, 2 graphics, 3 ticker
    in-out property <int> action-dialog: 0;

    // home
    in property <[LogRow]> recent-events;

    // layout
    in-out property <length> side-width: 420px;

    // "start", "stop", "skip", "restart", "manual-on", "manual-off", "clear-queue"
    callback transport(string);
    // rewind the item on air: to a fraction of it, or by seconds
    callback seek-to(float);
    callback seek-by(int);
    // seconds → "ЧЧ:ММ:СС"
    pure callback time-of(float) -> string;
    callback search-media(string);
    callback play-now(string);
    callback queue-media(string);
    callback ad-break(int, bool);
    callback switch-schedule(int);
    // element id, "show" / "hide" / "auto"
    callback graphic(string, string);
    callback apply-ticker(string);
}
