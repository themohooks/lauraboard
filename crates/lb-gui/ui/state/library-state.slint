// Data contract of the Media library screen (src/bridge/library.rs).

export struct MediaRow {
    // position in the filtered list
    row: int,
    id: string,
    title: string,
    kind: string,
    duration: string,
    category: string,
    format: string,
    problem: string,
    enabled: bool,
    checked: bool,
    thumb: image,
    has-thumb: bool,
}

// One line of tiles in the grid view (virtualized by rows).
export struct TileLine {
    tiles: [MediaRow],
}

// One folder of the tree (depth = nesting level).
export struct FolderRow {
    path: string,
    name: string,
    depth: int,
    // items in the folder and its subfolders
    count: int,
}

export struct MediaEdit {
    id: string,
    path: string,
    // file name before copying into the channel's storage
    original: string,
    // the file is the channel's own copy (deleted with the item)
    own: bool,
    info: string,
    problem: string,
}

export global Lib {
    in property <[MediaRow]> items;
    in property <[TileLine]> lines;
    in-out property <int> columns: 4;
    in property <string> summary;
    in property <bool> loading: true;

    // filters / sorting / view
    in-out property <string> filter;
    // -1 = all, otherwise kind index (program, jingle, ad, promo, filler, image, stream)
    in-out property <int> kind-filter: -1;
    in property <[string]> categories;
    // 0 = all categories
    in-out property <int> category-index: 0;
    in-out property <bool> problems-only;
    // 0 title, 1 kind, 2 duration, 3 category, 4 id
    in-out property <int> sort-key: 0;
    in-out property <bool> sort-desc;
    in-out property <bool> grid;
    in property <int> checked-count;
    in-out property <int> focused: -1;
    in property <[string]> playlists;

    // folders: tree, selected folder ("" = whole library), and the list
    // offered by selects (index 0 = top level)
    in property <[FolderRow]> folders;
    in property <int> items-total;
    in-out property <string> folder;
    in property <[string]> folder-options;
    callback select-folder(string);
    // folder name dialog: "" closed, "new" (inside the selected folder), "rename"
    in-out property <string> folder-dialog;
    in-out property <string> f-name;
    in property <string> f-error;
    callback folder-save();
    callback folder-delete();

    // edit sheet
    in-out property <bool> edit-open;
    in property <MediaEdit> edit;
    in-out property <string> e-title;
    in-out property <int> e-kind;
    in-out property <string> e-category;
    in-out property <string> e-volume;
    in-out property <string> e-weight;
    in-out property <bool> e-enabled;
    in-out property <int> e-folder;
    in property <string> e-volume-error;
    in property <string> e-weight-error;

    // edit sheet, display settings (scaling, crop, picture filters)
    // 0 = channel setting, 1 fit, 2 fill, 3 stretch, 4 blurred background
    in-out property <int> d-scale;
    // index in d-aspect-options (0 = from the file)
    in-out property <int> d-aspect;
    in property <[string]> d-aspect-options;
    // 0 none, 1 90° cw, 2 180°, 3 90° ccw
    in-out property <int> d-rotate;
    in-out property <bool> d-flip-h;
    in-out property <bool> d-flip-v;
    in-out property <bool> d-deinterlace;
    in-out property <float> d-crop-left;
    in-out property <float> d-crop-top;
    in-out property <float> d-crop-right;
    in-out property <float> d-crop-bottom;
    in-out property <float> d-brightness;
    in-out property <float> d-contrast: 1;
    in-out property <float> d-saturation: 1;
    in-out property <float> d-gamma: 1;
    in-out property <float> d-sharpen;
    in-out property <float> d-denoise;
    // all settings at their defaults
    in property <bool> d-default: true;
    // the item has a picture the server can render
    in property <bool> d-can-preview;
    in property <image> d-preview;
    in property <bool> d-has-preview;
    in property <bool> d-previewing;
    in property <string> d-preview-note;
    callback d-changed();
    callback d-reset();

    // import dialog
    in-out property <bool> import-open;
    in-out property <string> import-path;
    // 0 = auto, then kinds
    in-out property <int> import-kind;
    in-out property <string> import-category;
    in-out property <bool> import-recursive: true;
    // copy into the channel's own storage (otherwise files stay where they are)
    in-out property <bool> import-copy: true;
    in-out property <int> import-folder;
    in property <bool> importing;
    in property <bool> can-browse;
    in property <bool> checking;

    callback refresh-list();
    callback sort(int);
    callback columns-changed(int);
    callback toggle-check(int);
    callback check-all(bool);
    callback open-edit(int);
    callback validate-edit();
    callback save-edit();
    // "edit", "queue", "play-now", "add-to-open-playlist", "toggle", "delete"
    callback row-action(int, string);
    // "playlist" (arg = playlist index), "queue", "enable", "disable", "kind" (arg = kind),
    // "folder" (arg = index in folder-options), "delete"
    callback bulk(string, int);
    callback browse-import(bool);
    callback do-import();
    callback check-files();
}
