// Data contract of the "download from a site" dialog (src/bridge/download.rs).

export global Dl {
    in-out property <bool> open;
    in-out property <string> url;

    // yt-dlp on the server
    in property <bool> tool-checking: true;
    in property <bool> tool-ok;
    in property <string> tool-version;
    in property <bool> can-install;
    in property <bool> installing;

    // reading the link: "" nothing yet, "probing", "ready", "error"
    in property <string> step;
    in property <string> error;

    // what the link offers
    in property <string> title;
    // author · site · duration (or the number of videos of a playlist)
    in property <string> details;
    in property <image> thumb;
    in property <bool> has-thumb;
    in property <[string]> qualities;
    in-out property <int> quality;

    // where the videos go: 0 = auto, then kinds (as in the import dialog)
    in-out property <int> kind;
    in-out property <string> category;
    // index in Lib.folder-options
    in-out property <int> folder;
    in property <bool> starting;

    callback opened();
    callback probe();
    callback start();
    callback install-tool();
}
