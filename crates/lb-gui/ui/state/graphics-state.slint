// Data contract of the on-screen graphics editor (src/bridge/graphics.rs).
// Canvas coordinates are frame pixels; the canvas scales them to fit.

export struct CanvasItem {
    index: int,
    name: string,
    // text, ticker, clock, countdown, image, rect, group
    kind: string,
    x: float,
    y: float,
    w: float,
    h: float,
    hidden: bool,
    locked: bool,
    on-air: bool,
}

// A row of the layer panel: a layer header, or an element under it.
export struct LayerRow {
    header: bool,
    // element index (-1 on headers)
    index: int,
    name: string,
    kind: string,
    kind-name: string,
    layer: int,
    hidden: bool,
    locked: bool,
    on-air: bool,
    // header: elements shown under it, the layer goes on air, exclusive, folded
    count: int,
    enabled: bool,
    exclusive: bool,
    collapsed: bool,
    // element: shown only on scenes
    scene: bool,
}

// One text of an element as shown by a rule.
export struct RuleTextRow {
    // field name ("Строка 1" when unnamed)
    label: string,
    // the element's own text (shown when the rule keeps it)
    design: string,
    // the rule's text; empty = the design's
    text: string,
}

export struct GRuleRow {
    index: int,
    id: string,
    name: string,
    enabled: bool,
    element-index: int,
    priority: string,
    after: string,
    duration: string,
    before-end: string,
    last: string,
    every: string,
    at: string,
    categories: string,
    xcategories: string,
    media: string,
    xmedia: string,
    blocks: string,
    playlists: string,
    // daily window ЧЧ:ММ
    from: string,
    to: string,
    // content kinds the rule is limited to (KINDS order; none = all)
    kinds: [bool],
    // the element's text lines (plate) or text, replaced by this rule
    texts: [RuleTextRow],
    // labels of `texts`, for the "insert variable into line" select
    text-labels: [string],
    hide-empty: bool,
    error: string,
}

// One text line of a plate (properties list).
export struct PlateFieldRow {
    label: string,
    text: string,
}

// A font offered by the picker: a system family or a font file.
export struct FontRow {
    // value stored in the style (family name or file path)
    value: string,
    name: string,
    file: bool,
    // "файл канала", "Google Fonts" (not previewed: not on this computer)
    note: string,
}

// A ready-made plate texture.
export struct TextureRow {
    path: string,
    title: string,
    image: image,
    has-image: bool,
}

// A Google Fonts family in the download tab.
export struct GFontRow {
    family: string,
    // category and styles, "Без засечек · кириллица · жирный, курсив"
    info: string,
    downloaded: bool,
}

export struct VarRow {
    key: string,
    value: string,
}

export global Gfx {
    // 0 canvas, 1 display rules, 2 variables, 3 templates
    in-out property <int> tab;
    in property <bool> dirty;
    // what is edited: 0 the whole broadcast (channel graphics), then the
    // scenes of the library ("Сцена: …"), each with its own graphics
    in property <[string]> scopes;
    in-out property <int> scope;
    in property <bool> scene-scope;
    callback scope-changed(int);
    in property <bool> can-undo;
    in property <bool> can-redo;

    // canvas
    in property <float> frame-w: 1920;
    in property <float> frame-h: 1080;
    in property <[CanvasItem]> items;
    in-out property <int> selected: -1;
    in property <[float]> vguides;
    in property <[float]> hguides;
    in property <image> background;
    in property <bool> has-background;
    // 0 exact render, 1 live air, 2 none
    in-out property <int> bg-mode;
    in property <string> bg-note;
    in property <bool> rendering;
    in-out property <bool> snap: true;
    in-out property <bool> safe-area: true;
    in property <[LayerRow]> layers;

    // properties of the selected element (flat for two-way binding)
    in property <bool> p-has;
    in property <string> p-id;
    in-out property <string> p-name;
    // 0 text, 1 ticker, 2 clock, 3 countdown, 4 image, 5 rect, 6 group, 7 plate, 8 progress bar
    in property <int> p-kind;
    in-out property <int> p-anchor;
    in-out property <string> p-x;
    in-out property <string> p-y;
    in-out property <string> p-w;
    in-out property <string> p-h;
    in-out property <float> p-opacity: 1;
    // index in `layer-names`
    in-out property <int> p-layer;
    // layers, top first: "Плашки и титры · 20"
    in property <[string]> layer-names;
    // layer panel: 0 all, 1 common graphics, 2 graphics of scenes
    in-out property <int> layer-filter;
    // layer being renamed (id; i32::MIN none)
    in-out property <int> layer-editing: -2147483648;
    callback layer-filter-changed();
    callback layer-collapse(int);
    callback layer-toggle-enabled(int);
    callback layer-toggle-exclusive(int);
    callback layer-rename(int, string);
    // layer id, +1 up / -1 down
    callback layer-move(int, int);
    callback layer-add();
    // every element to the layer of its kind (asks first)
    callback layer-organize();
    callback layer-remove(int);
    in-out property <string> p-text;
    in-out property <string> p-speed;
    in-out property <string> p-twidth;
    in-out property <string> p-format;
    // countdown: 0 item, 1 next programme, 2 end of the programme
    in-out property <int> p-target;
    in-out property <string> p-prefix;
    // countdown time format: 0 auto, 1 ЧЧ:ММ:СС, 2 ММ:СС, 3 minutes
    in-out property <int> p-tformat;
    // content kinds not counted (KINDS order), toggled with toggle-exclude
    in property <[bool]> p-exclude;
    callback toggle-exclude(int);
    // progress bar: gradient of the fill, track colour, 0 programme / 1 item, direction
    in-out property <string> pg-gradient;
    in-out property <string> pg-track;
    in-out property <int> pg-target;
    // 0 left → right, 1 right → left, 2 bottom → top, 3 top → bottom
    in-out property <int> pg-direction;
    in property <color> sw-pg-gradient;
    in property <color> sw-pg-track;
    in-out property <string> p-path;
    in-out property <string> p-color;
    in-out property <string> p-rw;
    in-out property <string> p-rh;
    in-out property <string> p-radius;
    in-out property <string> p-children;
    in-out property <string> s-font;
    in-out property <bool> s-bold;
    in-out property <bool> s-italic;
    in-out property <string> s-size;
    in-out property <string> s-color;
    in-out property <string> s-outline;
    in-out property <string> s-outline-w;
    in-out property <string> s-shadow;
    in-out property <string> s-shadow-x;
    in-out property <string> s-shadow-y;
    in-out property <string> s-bg;
    in-out property <string> s-padding;
    in-out property <string> s-corner;
    in-out property <string> s-spacing;
    in-out property <bool> s-upper;
    // shape design (rectangle, plate)
    in-out property <string> sh-gradient;
    in-out property <string> sh-angle;
    in-out property <string> sh-border;
    in-out property <string> sh-border-w;
    // "tl tr br bl"; empty = the single radius
    in-out property <string> sh-corners;
    in-out property <string> sh-skew;
    in-out property <string> sh-shadow;
    in-out property <string> sh-shadow-blur;
    in-out property <string> sh-shadow-x;
    in-out property <string> sh-shadow-y;
    // 0 none, 1 left, 2 top, 3 right, 4 bottom
    in-out property <int> sh-accent-side;
    in-out property <string> sh-accent-size;
    in-out property <string> sh-accent-color;
    in-out property <string> sh-image;
    in property <color> sw-sh-gradient;
    in property <color> sw-sh-border;
    in property <color> sw-sh-shadow;
    in property <color> sw-sh-accent;

    // plate: layout and its text lines; the selected line is edited with
    // p-text / pl-label and the text style fields
    in-out property <string> pl-width;
    in-out property <string> pl-min-width;
    in-out property <string> pl-pad-x;
    in-out property <string> pl-pad-y;
    in-out property <string> pl-spacing;
    // 0 left, 1 centre, 2 right
    in-out property <int> pl-align;
    // 0 column, 1 row; vertical 0 top, 1 centre, 2 bottom; shrink long lines
    in-out property <int> pl-layout;
    in-out property <int> pl-valign: 1;
    in-out property <bool> pl-fit;
    // selected line: 0 as the plate, 1 left, 2 centre, 3 right; gap before it
    in-out property <int> pl-line-align;
    in-out property <string> pl-gap;
    // picture in the plate: path ("" none), 0 left / 1 right, height, gap, radius
    in-out property <string> pl-icon;
    in-out property <int> pl-icon-side;
    in-out property <string> pl-icon-size;
    in-out property <string> pl-icon-gap;
    in-out property <string> pl-icon-radius;
    callback pick-plate-icon();
    // advanced plate editor: open, cropped exact preview, its backdrop
    // (0 dark, 1 light, 2 grey), ready-made styles
    in-out property <bool> pe-open;
    in property <image> pe-preview;
    in property <bool> pe-has-preview;
    in property <bool> pe-busy;
    in-out property <int> pe-bg;
    in property <[string]> pe-presets;
    callback open-plate-editor();
    callback plate-preset(int);
    // the user's own saved styles (names), the name for a new one
    in property <[string]> pe-mine;
    in-out property <string> pe-mine-name;
    callback plate-style-save();
    callback plate-style-apply(int);
    callback plate-style-remove(int);
    in property <[PlateFieldRow]> pl-fields;
    in-out property <int> pl-field;
    in-out property <string> pl-label;
    callback plate-field-select(int);
    callback plate-field-add();
    callback plate-field-remove(int);
    callback plate-field-move(int, int);
    callback pick-shape-image();
    // ready-made textures dialog
    in-out property <bool> tex-open;
    in property <bool> tex-loading;
    in property <[TextureRow]> tex-list;
    callback open-textures();
    callback texture-pick(string);

    // font picker
    in-out property <bool> font-open;
    in-out property <string> font-query;
    in property <[FontRow]> font-list;
    in property <bool> font-loading;
    callback open-fonts();
    callback font-search(string);
    callback font-pick(string);
    callback font-upload();
    // font dialog tab: 0 fonts of the server and channel, 1 Google Fonts
    in-out property <int> font-tab;
    in-out property <string> gf-query;
    in-out property <bool> gf-cyrillic: true;
    in property <[GFontRow]> gf-list;
    in property <bool> gf-loading;
    in property <string> gf-error;
    // family being downloaded ("" none)
    in property <string> gf-busy;
    callback gf-search();
    callback gf-download(string);

    // 0 none, 1 fade, 2 slide left, 3 slide right, 4 slide up, 5 slide down
    in-out property <int> a-in;
    in-out property <int> a-out;
    in-out property <string> a-ms;
    in-out property <string> p-profiles;
    in property <string> prop-errors;
    in property <color> sw-p-color;
    in property <color> sw-s-color;
    in property <color> sw-s-outline;
    in property <color> sw-s-shadow;
    in property <color> sw-s-bg;

    // animation preview
    in property <[image]> anim-frames;
    in-out property <bool> anim-playing;
    in-out property <int> anim-index;

    // display rules
    in property <[GRuleRow]> rules;
    in property <[string]> element-names;

    // variables
    in property <[VarRow]> vars;
    in-out property <string> new-key;
    in-out property <string> new-value;

    // templates
    in property <[string]> templates;
    in-out property <string> template-name;

    callback select(int);
    callback drag-start(int, int);
    // element, handle (-1 = move), dx, dy in frame px
    callback drag-move(int, int, float, float);
    callback drag-end();
    callback nudge(float, float);
    callback props-changed();
    // colour picker: colour → "#RRGGBB" / "#RRGGBBAA", and back
    pure callback color-hex(color) -> string;
    pure callback parse-color(string) -> color;
    // append a {variable} to the selected element's text
    // animation presets, in the order of AnimKind::ALL (lb-core)
    out property <[string]> anim-in-names: [
        "Нет", "Растворение",
        "Въезд справа", "Въезд слева", "Въезд снизу", "Въезд сверху",
        "Сдвиг справа + растворение", "Сдвиг слева + растворение", "Подъём снизу + растворение", "Спуск сверху + растворение",
        "Приближение", "Отдаление", "Пружина",
        "Шторка справа налево", "Шторка слева направо", "Шторка снизу вверх", "Шторка сверху вниз",
        "Раскрытие по ширине", "Раскрытие по высоте",
        "Прыжок снизу", "Падение сверху", "Поворот", "Мерцание",
    ];
    out property <[string]> anim-out-names: [
        "Нет", "Растворение",
        "Уезд влево", "Уезд вправо", "Уезд вверх", "Уезд вниз",
        "Сдвиг влево + растворение", "Сдвиг вправо + растворение", "Подъём вверх + растворение", "Спуск вниз + растворение",
        "Уменьшение", "Увеличение", "Пружина (сжатие)",
        "Шторка влево", "Шторка вправо", "Шторка вверх", "Шторка вниз",
        "Сжатие по ширине", "Сжатие по высоте",
        "Уход вниз с отскоком", "Уход вверх с отскоком", "Поворот", "Мерцание",
    ];
    callback insert-var(string);
    // file dialog for the image element
    callback pick-image();
    callback add(string);
    callback duplicate();
    callback remove();
    // element index, +1 to the layer above / -1 below
    callback layer-step(int, int);
    callback toggle-hidden(int);
    callback toggle-locked(int);
    callback live(string);
    callback render();
    callback preview-animation();
    callback rule-edited(int, string, string);
    // rule index, text line, "{variable}": appended to that line's text
    callback rule-insert-var(int, int, string);
    callback rule-add();
    callback rule-remove(int);
    callback var-edited(int, string);
    callback var-add();
    callback var-remove(int);
    callback template-save();
    callback template-apply(int);
    callback template-delete(int);
    callback save();
    callback revert();
    callback undo();
    callback redo();
}
