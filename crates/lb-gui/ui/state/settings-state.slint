// Data contract of the settings screen (src/bridge/settings.rs).

export global Settings {
    in property <[string]> preview-options;
    in-out property <int> preview-preset;
    in-out property <string> preview-fps: "15";
    in property <string> preview-info;
    callback preview-selected(int);
    callback preview-save();
    in-out property <bool> hls-enabled;
    in-out property <string> hls-port: "8788";
    in property <bool> hls-can-edit;
    in property <string> hls-url;
    callback hls-save();
    // 0 system, 1 light, 2 dark
    in-out property <int> theme;
    // 80 … 200 %
    in-out property <int> scale: 100;
    in-out property <bool> compact;
    // 0 system, 1 on, 2 off
    in-out property <int> motion;
    in property <bool> system-reduce-motion;
    in-out property <bool> nav-expanded: true;
    in-out property <bool> close-to-tray: true;
    // no notification area on this system: closing quits
    in property <bool> has-tray;

    in property <string> api-url;
    in property <bool> online;
    in property <string> channels;
    in property <string> server-version;
    in property <string> app-version;
    in property <string> prefs-path;

    callback theme-changed(int);
    callback scale-changed(int);
    callback compact-changed(bool);
    callback motion-changed(int);
    callback nav-changed(bool);
    callback close-to-tray-changed(bool);
    // system notifications: 0 on, 1 errors, 2 skipped, 3 outputs, 4 disk,
    // 5 air, 6 programmes, 7 only while hidden
    in property <[bool]> notify: [true, true, true, true, true, true, false, false];
    callback notify-changed(int, bool);
    callback notify-test();
    callback reset-layout();
    callback reset-all();
}
