// Playlists screen: list | splitter | editor | side sheet.

import { Theme } from "../../theme/tokens.slint";
import { Splitter } from "../../components/splitter.slint";
import { App } from "../../state/app-state.slint";
import { Pl } from "../../state/playlists-state.slint";
import { Page } from "../../shell/page.slint";
import { PlaylistListPanel } from "list-panel.slint";
import { PlaylistEditor } from "editor.slint";
import { PlaylistSheet } from "sheet.slint";

export component PlaylistsScreen inherits Page {
    // The sheet sits on top at the right edge instead of sharing a layout:
    // content that cannot shrink any further goes under the sheet rather
    // than pushing it out of the window.
    HorizontalLayout {
        x: 0;
        y: 0;
        width: root.width - sheet.width;
        height: root.height;
        padding: Theme.sp4;
        padding-right: 0;
        spacing: Theme.sp1;
        PlaylistListPanel {
            width: Pl.list-width;
        }
        Splitter {
            size <=> Pl.list-width;
            minimum: 200px;
            maximum: 480px;
            committed(s) => {
                App.panel-resized("playlists.list", s);
            }
        }
        PlaylistEditor {
            horizontal-stretch: 1;
            padding-left: Theme.sp2;
            padding-right: Theme.sp4;
        }
    }
    sheet := PlaylistSheet {
        x: root.width - self.width;
        y: 0;
        height: root.height;
    }
}
