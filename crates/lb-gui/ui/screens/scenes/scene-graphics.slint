// Screen graphics of a scene: the channel's graphics rules limited to this
// scene (its media id), plus a shortcut to add one. Rules for all items
// (logo, ticker…) show over the scene too, by their own conditions.

import { Theme } from "../../theme/tokens.slint";
import { Icons } from "../../theme/icons.slint";
import { Label } from "../../components/label.slint";
import { Select } from "../../components/select.slint";
import { Switch } from "../../components/switch.slint";
import { Button, ButtonVariant } from "../../components/button.slint";
import { IconButton } from "../../components/icon-button.slint";
import { Scenes } from "../../state/scenes-state.slint";
import { FormSection } from "../rules/form-parts.slint";

export component SceneGraphics inherits FormSection {
    property <int> picked: -1;
    title: "Экранная графика";
    hint: "правила показа только для этой сцены";
    icon: Icons.branding-watermark;
    Label {
        text: "Общие правила (логотип, бегущая строка, часы) тоже действуют на сцене — по типу и категории, как для любого ролика.";
        wrap: word-wrap;
        type-style: Theme.body-small;
        color: Theme.color.on-surface-variant;
    }
    if Scenes.gfx.length == 0: Label {
        text: "Своих правил у сцены нет.";
        color: Theme.color.on-surface-variant;
    }
    for g in Scenes.gfx: HorizontalLayout {
        spacing: Theme.sp2;
        height: 44px;
        VerticalLayout {
            alignment: center;
            Switch {
                checked: g.enabled;
                toggled => {
                    Scenes.gfx-toggle(g.index);
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Label {
                text: g.name;
                type-style: Theme.label-large;
            }
            Label {
                text: "элемент: " + g.element;
                type-style: Theme.body-small;
                color: Theme.color.on-surface-variant;
            }
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                icon: Icons.delete;
                tooltip: "Удалить правило показа";
                clicked => {
                    Scenes.gfx-remove(g.index);
                }
            }
        }
    }
    HorizontalLayout {
        spacing: Theme.sp2;
        Select {
            horizontal-stretch: 1;
            label: "Показать элемент на сцене";
            options: Scenes.element-names;
            current-index: root.picked;
            placeholder: Scenes.element-names.length == 0 ? "Нет элементов графики" : "Выберите элемент";
            container-color: Theme.color.surface-container-low;
            selected(i, _) => {
                root.picked = i;
            }
        }
        VerticalLayout {
            alignment: start;
            padding-top: 4px;
            Button {
                text: "Добавить";
                icon: Icons.add;
                has-icon: true;
                variant: ButtonVariant.tonal;
                enabled: root.picked >= 0;
                clicked => {
                    Scenes.gfx-add(root.picked);
                    root.picked = -1;
                }
            }
        }
    }
    HorizontalLayout {
        alignment: start;
        Button {
            text: "Открыть экранную графику";
            icon: Icons.branding-watermark;
            has-icon: true;
            variant: ButtonVariant.text;
            tooltip: "Дизайн элементов и подробные правила показа";
            clicked => {
                Scenes.open-graphics();
            }
        }
    }
}
