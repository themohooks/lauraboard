// Screen graphics of a scene: its own elements and rules (edited in the
// graphics editor with the scene as the scope, kept apart from the channel
// graphics), the channel graphics over it on / off, and rules of the
// channel graphics limited to this scene (the older way).

import { Theme } from "../../theme/tokens.slint";
import { Icons } from "../../theme/icons.slint";
import { Label } from "../../components/label.slint";
import { Switch } from "../../components/switch.slint";
import { Button, ButtonVariant } from "../../components/button.slint";
import { IconButton } from "../../components/icon-button.slint";
import { Scenes } from "../../state/scenes-state.slint";
import { FormSection } from "../rules/form-parts.slint";

export component SceneGraphics inherits FormSection {
    title: "Экранная графика";
    hint: "своя у каждой сцены";
    icon: Icons.branding-watermark;
    HorizontalLayout {
        spacing: Theme.sp2;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Label {
                text: Scenes.gfx-summary;
                type-style: Theme.label-large;
                wrap: word-wrap;
            }
            Label {
                text: "В редакторе можно добавить HTML / SWF анимацию, задать размер кадра и правило показа на всю сцену. Элементы и правила хранятся в самой сцене.";
                wrap: word-wrap;
                type-style: Theme.body-small;
                color: Theme.color.on-surface-variant;
            }
        }
        VerticalLayout {
            alignment: center;
            Button {
                text: "Редактировать графику сцены";
                icon: Icons.branding-watermark;
                has-icon: true;
                variant: ButtonVariant.tonal;
                tooltip: "Открыть редактор графики для этой сцены";
                clicked => {
                    Scenes.open-graphics();
                }
            }
        }
    }
    HorizontalLayout {
        spacing: Theme.sp2;
        VerticalLayout {
            alignment: center;
            Switch {
                checked: Scenes.gfx-channel;
                toggled(on) => {
                    Scenes.gfx-channel-toggled(on);
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Label {
                text: "Графика эфира поверх сцены";
                type-style: Theme.label-large;
            }
            Label {
                text: "Логотип, бегущая строка и другие общие правила — по типу и категории, как для любого ролика.";
                wrap: word-wrap;
                type-style: Theme.body-small;
                color: Theme.color.on-surface-variant;
            }
        }
    }
    if Scenes.gfx.length > 0: Label {
        text: "Правила графики эфира только для этой сцены:";
        type-style: Theme.title-small;
    }
    for g in Scenes.gfx: HorizontalLayout {
        spacing: Theme.sp2;
        height: 44px;
        VerticalLayout {
            alignment: center;
            Switch {
                checked: g.enabled;
                toggled => {
                    Scenes.gfx-toggle(g.index);
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Label {
                text: g.name;
                type-style: Theme.label-large;
            }
            Label {
                text: "элемент эфира: " + g.element;
                type-style: Theme.body-small;
                color: Theme.color.on-surface-variant;
            }
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                icon: Icons.delete;
                tooltip: "Удалить правило показа";
                clicked => {
                    Scenes.gfx-remove(g.index);
                }
            }
        }
    }
}
