import { CategorySelect, CategoryMultiSelect } from "../../components/category-select.slint";
// Graphics tabs besides the canvas: display rules, template variables,
// saved design templates.

import { ScrollView, ListView } from "std-widgets.slint";
import { Theme } from "../../theme/tokens.slint";
import { Icons } from "../../theme/icons.slint";
import { Label } from "../../components/label.slint";
import { TextField } from "../../components/text-field.slint";
import { Select } from "../../components/select.slint";
import { Switch } from "../../components/switch.slint";
import { Button, ButtonVariant } from "../../components/button.slint";
import { IconButton } from "../../components/icon-button.slint";
import { ListRow } from "../../components/list-row.slint";
import { EmptyState } from "../../components/feedback.slint";
import { VarList } from "var-help.slint";
import { Gfx, GRuleRow } from "../../state/graphics-state.slint";
import { FormSection, ToggleChips } from "../rules/form-parts.slint";

component RuleCard inherits FormSection {
    in property <GRuleRow> r;
    // variable picker for the rule's own text, and the line it fills
    property <bool> show-vars;
    property <int> var-line;
    title: r.name;
    hint: "id: " + r.id;
    TextField { label: "Название правила"; text: root.r.name; edited(t) => { Gfx.rule-edited(root.r.index, "name", t); } }
    icon: Icons.rule;
    HorizontalLayout {
        spacing: Theme.sp3;
        VerticalLayout {
            alignment: center;
            Switch {
                text: "Включено";
                checked: root.r.enabled;
                toggled(on) => {
                    Gfx.rule-edited(root.r.index, "enabled", on ? "1" : "0");
                }
            }
        }
        Select {
            horizontal-stretch: 1;
            label: "Элемент";
            options: Gfx.element-names;
            current-index: root.r.element-index;
            selected(i, _) => {
                Gfx.rule-edited(root.r.index, "element", i);
            }
        }
        TextField {
            width: 110px;
            label: "Приоритет";
            text: root.r.priority;
            mono: true;
            edited(t) => {
                Gfx.rule-edited(root.r.index, "priority", t);
            }
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                icon: Icons.delete;
                tooltip: "Удалить правило";
                clicked => {
                    Gfx.rule-remove(root.r.index);
                }
            }
        }
    }
    HorizontalLayout {
        spacing: Theme.sp2;
        TextField { label: "Через (от начала)"; text: root.r.after; mono: true; placeholder: "00:00:10"; edited(t) => { Gfx.rule-edited(root.r.index, "after", t); } }
        TextField { label: "Показывать"; text: root.r.duration; mono: true; placeholder: "до конца"; edited(t) => { Gfx.rule-edited(root.r.index, "duration", t); } }
        TextField { label: "Скрыть до конца за"; text: root.r.before-end; mono: true; edited(t) => { Gfx.rule-edited(root.r.index, "before-end", t); } }
        TextField { label: "Последние"; text: root.r.last; mono: true; edited(t) => { Gfx.rule-edited(root.r.index, "last", t); } }
        TextField { label: "Каждые"; text: root.r.every; mono: true; edited(t) => { Gfx.rule-edited(root.r.index, "every", t); } }
    }
    HorizontalLayout {
        spacing: Theme.sp2;
        TextField {
            horizontal-stretch: 1;
            label: "В точное время (ЧЧ:ММ через запятую)";
            text: root.r.at;
            mono: true;
            edited(t) => {
                Gfx.rule-edited(root.r.index, "at", t);
            }
        }
        TextField {
            width: 96px;
            label: "Часы с";
            text: root.r.from;
            mono: true;
            placeholder: "ЧЧ:ММ";
            edited(t) => {
                Gfx.rule-edited(root.r.index, "from", t);
            }
        }
        TextField {
            width: 96px;
            label: "до";
            text: root.r.to;
            mono: true;
            placeholder: "ЧЧ:ММ";
            edited(t) => {
                Gfx.rule-edited(root.r.index, "to", t);
            }
        }
    }
    HorizontalLayout {
        spacing: Theme.sp2;
        CategoryMultiSelect {
            horizontal-stretch: 1;
            label: "Только для категорий";
            text: root.r.categories;
            edited(t) => {
                Gfx.rule-edited(root.r.index, "categories", t);
            }
        }
        CategoryMultiSelect {
            horizontal-stretch: 1;
            label: "Кроме категорий";
            text: root.r.xcategories;
            edited(t) => {
                Gfx.rule-edited(root.r.index, "xcategories", t);
            }
        }
    }
    HorizontalLayout {
        spacing: Theme.sp2;
        TextField { horizontal-stretch: 1; label: "Только ролики (ID через запятую)"; text: root.r.media; edited(t) => { Gfx.rule-edited(root.r.index, "media", t); } }
        TextField { horizontal-stretch: 1; label: "Кроме роликов (ID)"; text: root.r.xmedia; edited(t) => { Gfx.rule-edited(root.r.index, "xmedia", t); } }
    }
    HorizontalLayout {
        spacing: Theme.sp2;
        TextField { horizontal-stretch: 1; label: "Только блоки (ID)"; text: root.r.blocks; edited(t) => { Gfx.rule-edited(root.r.index, "blocks", t); } }
        TextField { horizontal-stretch: 1; label: "Только плейлисты (ID)"; text: root.r.playlists; edited(t) => { Gfx.rule-edited(root.r.index, "playlists", t); } }
    }
    Label { text: "Пустые фильтры — весь эфир. Заполненные фильтры действуют одновременно. ID ролика можно посмотреть нажатием на него в очереди эфира."; wrap: word-wrap; color: Theme.color.on-surface-variant; }
    Label {
        text: "Типы контента (ничего не выбрано — любые)";
        type-style: Theme.label-medium;
        color: Theme.color.on-surface-variant;
    }
    ToggleChips {
        labels: ["Передачи", "Заставки", "Реклама", "Анонсы", "Заполнение", "Изображения", "Потоки"];
        values: root.r.kinds;
        toggled(i) => {
            Gfx.rule-edited(root.r.index, "kind", i);
        }
    }
    if root.r.texts.length > 0: VerticalLayout {
        spacing: Theme.sp3;
        Label {
            text: "Текст по этому правилу — пусто: как в дизайне элемента; {переменные} подставляются";
            type-style: Theme.label-medium;
            color: Theme.color.on-surface-variant;
            wrap: word-wrap;
        }
        for t[k] in root.r.texts: TextField {
            label: t.label;
            text: t.text;
            placeholder: t.design;
            edited(v) => {
                Gfx.rule-edited(root.r.index, "text:" + k, v);
            }
            changed has-focus => {
                if self.has-focus {
                    root.var-line = k;
                }
            }
        }
        HorizontalLayout {
            alignment: start;
            spacing: Theme.sp2;
            Button {
                text: root.show-vars ? "Скрыть переменные" : "Вставить переменную";
                icon: root.show-vars ? Icons.expand-less : Icons.expand-more;
                has-icon: true;
                variant: ButtonVariant.text;
                clicked => {
                    root.show-vars = !root.show-vars;
                }
            }
            if root.show-vars && root.r.texts.length > 1: Select {
                width: 220px;
                label: "В строку";
                options: root.r.text-labels;
                current-index <=> root.var-line;
            }
        }
        if root.show-vars: Rectangle {
            border-radius: Theme.radius-m;
            background: Theme.color.surface-container;
            VerticalLayout {
                padding: Theme.sp1;
                VarList {
                    insertable: true;
                    insert(v) => {
                        Gfx.rule-insert-var(root.r.index, root.var-line, v);
                    }
                }
            }
        }
        Switch {
            text: "Не показывать, если весь текст пустой (например, нет {presenter})";
            checked: root.r.hide-empty;
            toggled(on) => {
                Gfx.rule-edited(root.r.index, "hide-empty", on ? "1" : "0");
            }
        }
    }
    if root.r.error != "": Label {
        text: root.r.error;
        type-style: Theme.body-small;
        color: Theme.color.error;
    }
}

export component GfxRulesTab inherits VerticalLayout {
    spacing: Theme.sp3;
    HorizontalLayout {
        Label {
            horizontal-stretch: 1;
            text: "Выберите элемент и условия показа, затем сохраните. Для логотипа на передачах выберите тип «Передачи». Для плашки через 10 секунд на 8 секунд: «Через» = 00:00:10, «Показывать» = 00:00:08. Плавность задаётся в анимации элемента. Ручной показ в эфире действует до нажатия «По правилам».";
            wrap: word-wrap;
            color: Theme.color.on-surface-variant;
            vertical-alignment: center;
        }
        Button {
            text: "Новое правило показа";
            icon: Icons.add;
            has-icon: true;
            clicked => {
                Gfx.rule-add();
            }
        }
    }
    if Gfx.rules.length == 0: EmptyState {
        vertical-stretch: 1;
        icon: Icons.rule;
        title: "Нет правил показа";
        text: "Без правил элементы показываются только вручную.";
    }
    if Gfx.rules.length > 0: sv := ScrollView {
        vertical-stretch: 1;
        VerticalLayout {
            width: sv.visible-width;
            padding-right: Theme.sp3;
            padding-top: Theme.sp1;
            spacing: Theme.sp3;
            alignment: start;
            for r in Gfx.rules: RuleCard {
                r: r;
            }
        }
    }
}

component VarsBody inherits VerticalLayout {
    spacing: Theme.sp3;
    alignment: start;
    Label {
        text: "Переменная — слово в фигурных скобках внутри текста элемента, например «Далее: {next_title} в {next_start}». В эфире вместо неё подставляется значение: «Далее: Реклама: блок 1 в 09:28». Здесь задаются собственные переменные канала и их значения по умолчанию; оператор может менять их в эфире (например, {ticker}).";
        color: Theme.color.on-surface-variant;
        wrap: word-wrap;
    }
    for v[i] in Gfx.vars: HorizontalLayout {
        spacing: Theme.sp2;
        Label {
            width: 180px;
            text: "{" + v.key + "}";
            mono: true;
            vertical-alignment: center;
        }
        TextField {
            horizontal-stretch: 1;
            text: v.value;
            edited(t) => {
                Gfx.var-edited(i, t);
            }
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                icon: Icons.delete;
                tooltip: "Удалить переменную";
                clicked => {
                    Gfx.var-remove(i);
                }
            }
        }
    }
    HorizontalLayout {
        spacing: Theme.sp2;
        TextField {
            width: 180px;
            label: "Имя";
            text <=> Gfx.new-key;
            mono: true;
        }
        TextField {
            horizontal-stretch: 1;
            label: "Значение";
            text <=> Gfx.new-value;
        }
        VerticalLayout {
            alignment: center;
            Button {
                text: "Добавить";
                variant: ButtonVariant.tonal;
                enabled: Gfx.new-key != "";
                clicked => {
                    Gfx.var-add();
                }
            }
        }
    }
    Label {
        text: "Справочник переменных";
        type-style: Theme.title-small;
    }
    Rectangle {
        border-radius: Theme.radius-m;
        background: Theme.color.surface-container-low;
        VerticalLayout {
            padding: Theme.sp2;
            VarList { }
        }
    }
}

export component GfxVarsTab inherits VerticalLayout {
    sv := ScrollView {
        vertical-stretch: 1;
        VarsBody {
            width: sv.visible-width;
            padding-right: Theme.sp3;
            padding-bottom: Theme.sp3;
        }
    }
}

export component GfxTemplatesTab inherits VerticalLayout {
    spacing: Theme.sp3;
    alignment: start;
    Label {
        text: "Шаблон оформления — сохранённый набор элементов, правил и переменных. Хранится на этом компьютере и применяется к любому каналу.";
        color: Theme.color.on-surface-variant;
        wrap: word-wrap;
    }
    HorizontalLayout {
        spacing: Theme.sp2;
        TextField {
            horizontal-stretch: 1;
            label: "Название шаблона";
            text <=> Gfx.template-name;
        }
        VerticalLayout {
            alignment: center;
            Button {
                text: "Сохранить текущее оформление";
                icon: Icons.save;
                has-icon: true;
                enabled: Gfx.template-name != "";
                clicked => {
                    Gfx.template-save();
                }
            }
        }
    }
    if Gfx.templates.length == 0: EmptyState {
        icon: Icons.palette;
        title: "Нет сохранённых шаблонов";
    }
    for t[i] in Gfx.templates: ListRow {
        focusable: false;
        Label {
            horizontal-stretch: 1;
            text: t;
        }
        VerticalLayout {
            alignment: center;
            Button {
                text: "Применить";
                variant: ButtonVariant.tonal;
                clicked => {
                    Gfx.template-apply(i);
                }
            }
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                icon: Icons.delete;
                tooltip: "Удалить шаблон";
                clicked => {
                    Gfx.template-delete(i);
                }
            }
        }
    }
}
