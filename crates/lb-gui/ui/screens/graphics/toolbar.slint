// Graphics editor toolbar: add elements, background, guides, render,
// animation preview, live control of the selection.

import { Theme } from "../../theme/tokens.slint";
import { Icons } from "../../theme/icons.slint";
import { Label } from "../../components/label.slint";
import { IconButton, IconButtonVariant } from "../../components/icon-button.slint";
import { Button, ButtonVariant } from "../../components/button.slint";
import { Select } from "../../components/select.slint";
import { Menu } from "../../components/menu.slint";
import { CircularProgress } from "../../components/feedback.slint";
import { Gfx } from "../../state/graphics-state.slint";
import { App } from "../../state/app-state.slint";

component LiveTools inherits HorizontalLayout {
    spacing: Theme.sp1;
    IconButton {
        icon: Gfx.anim-playing ? Icons.stop : Icons.animation;
        toggle: true;
        selected: Gfx.anim-playing;
        enabled: Gfx.selected >= 0;
        tooltip: Gfx.anim-playing ? "Остановить предпросмотр" : "Предпросмотр появления выбранного элемента";
        clicked => {
            if Gfx.anim-playing {
                Gfx.anim-playing = false;
            } else {
                Gfx.preview-animation();
            }
        }
    }
    Rectangle {
        width: Theme.sp2;
    }
    IconButton {
        icon: Icons.visibility;
        variant: IconButtonVariant.tonal;
        tooltip: "Показать в эфире";
        enabled: Gfx.selected >= 0;
        clicked => {
            Gfx.live("show");
        }
    }
    IconButton {
        icon: Icons.visibility-off;
        tooltip: "Скрыть в эфире";
        enabled: Gfx.selected >= 0;
        clicked => {
            Gfx.live("hide");
        }
    }
    IconButton {
        icon: Icons.motion-photos-on;
        tooltip: "По правилам показа";
        enabled: Gfx.selected >= 0;
        clicked => {
            Gfx.live("auto");
        }
    }
}

component ToolRow inherits HorizontalLayout {
    spacing: Theme.sp1;

    add := Button {
        text: "Добавить";
        icon: Icons.add;
        has-icon: true;
        variant: ButtonVariant.tonal;
        clicked => {
            menu.open-at(0, add.height);
        }
        menu := Menu {
            menu-width: 320px;
            entries: [
                { id: "text", text: "Текст", icon: Icons.text-fields, has-icon: true, enabled: true },
                { id: "plate", text: "Плашка с текстом", icon: Icons.subtitles, has-icon: true, enabled: true },
                { id: "rect", text: "Фигура", icon: Icons.crop-square, has-icon: true, enabled: true },
                { id: "image", text: "Изображение", icon: Icons.image, has-icon: true, enabled: true },
                { id: "web", text: "HTML / SWF анимация", icon: Icons.animation, has-icon: true, enabled: true, badge: "НЕСТАБИЛЬНО" },
                { id: "avatar", text: "Аватар канала", icon: Icons.image, has-icon: true, enabled: true },
                { id: "clock", text: "Часы", icon: Icons.schedule, has-icon: true, enabled: true },
                { id: "countdown", text: "Таймер", icon: Icons.timer, has-icon: true, enabled: true },
                { id: "program-left", text: "До конца передачи", icon: Icons.timer, has-icon: true, enabled: true },
                { id: "progress", text: "Прогресс передачи", icon: Icons.linear-scale, has-icon: true, enabled: true },
                { id: "ticker", text: "Бегущая строка", icon: Icons.subtitles, has-icon: true, enabled: true },
            ];
            activated(id) => {
                Gfx.add(id);
            }
        }
    }
    IconButton {
        icon: Icons.content-copy;
        tooltip: "Дублировать";
        enabled: Gfx.selected >= 0;
        clicked => {
            Gfx.duplicate();
        }
    }
    IconButton {
        icon: Icons.delete;
        tooltip: "Удалить (Del)";
        enabled: Gfx.selected >= 0;
        clicked => {
            Gfx.remove();
        }
    }
    Rectangle {
        width: Theme.sp2;
    }
    IconButton {
        icon: Icons.grid-view;
        toggle: true;
        selected <=> Gfx.snap;
        tooltip: "Привязка к краям, центру и безопасной зоне";
        clicked => {
            Gfx.snap = !Gfx.snap;
        }
    }
    IconButton {
        icon: Icons.crop-square;
        toggle: true;
        selected <=> Gfx.safe-area;
        tooltip: "Показать безопасную зону (5 %)";
        clicked => {
            Gfx.safe-area = !Gfx.safe-area;
        }
    }
    Select {
        width: 176px;
        options: ["Фон: точный рендер", "Фон: эфир", "Фон: без фона"];
        current-index <=> Gfx.bg-mode;
        selected => {
            Gfx.render();
        }
    }
    IconButton {
        icon: Icons.refresh;
        tooltip: "Обновить рендер";
        enabled: Gfx.bg-mode == 0;
        clicked => {
            Gfx.render();
        }
    }
    if Gfx.rendering: VerticalLayout {
        alignment: center;
        CircularProgress {
            size: 20px;
        }
    }
    Rectangle {
        horizontal-stretch: 1;
    }
    if !App.narrow: LiveTools { }
}

export component GfxToolbar inherits VerticalLayout {
    spacing: Theme.sp1;
    HorizontalLayout {
        spacing: Theme.sp1;
        ToolRow { }
    }
    if App.narrow: HorizontalLayout {
        LiveTools { }
        Rectangle {
            horizontal-stretch: 1;
        }
    }
}
