// Properties of the selected element: placement (anchor grid, offsets,
// size), opacity and layer, content by kind, text style, animation.

import { ScrollView } from "std-widgets.slint";
import { Theme } from "../../theme/tokens.slint";
import { Icons } from "../../theme/icons.slint";
import { Label } from "../../components/label.slint";
import { Select } from "../../components/select.slint";
import { Slider } from "../../components/slider.slint";
import { Interactive } from "../../components/interactive.slint";
import { Button, ButtonVariant } from "../../components/button.slint";
import { EmptyState } from "../../components/feedback.slint";
import { Gfx } from "../../state/graphics-state.slint";
import { App } from "../../state/app-state.slint";
import { VarList } from "var-help.slint";
import { FormSection } from "../rules/form-parts.slint";
import { Checkbox } from "../../components/checkbox.slint";
import { Field, ColorField } from "prop-fields.slint";
import { ShapeSection } from "shape-props.slint";
import { ToggleChips } from "../rules/form-parts.slint";
import { PlateSection } from "plate-props.slint";
import { TextStyleSection } from "text-style.slint";

component AnchorGrid inherits Rectangle {
    width: 3 * 28px + 2 * 4px;
    height: self.width;
    for i in 9: Interactive {
        x: mod(i, 3) * 32px;
        y: floor(i / 3) * 32px;
        width: 28px;
        height: 28px;
        radius: Theme.radius-xs;
        background: Gfx.p-anchor == i ? Theme.color.primary : Theme.color.surface-container-highest;
        accessible-role: radio-button;
        accessible-checked: Gfx.p-anchor == i;
        accessible-label: "Привязка " + (i + 1);
        clicked => {
            Gfx.p-anchor = i;
            Gfx.props-changed();
        }
        Rectangle {
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: Gfx.p-anchor == i ? Theme.color.on-primary : Theme.color.on-surface-variant;
        }
    }
}

export component PropertiesPanel inherits Rectangle {
    // variable reference under the text field
    property <bool> show-vars;
    border-radius: Theme.radius-l;
    background: Theme.color.surface-container-low;
    clip: true;

    if !Gfx.p-has: EmptyState {
        icon: Icons.tune;
        title: "Выберите элемент";
        text: "Щёлкните элемент на холсте или в списке слоёв.";
    }

    if Gfx.p-has: sv := ScrollView {
        // vertical scrolling only: the fields follow the panel width
        content-width: self.visible-width;
        horizontal-scrollbar-policy: always-off;
        VerticalLayout {
            width: sv.visible-width;
            padding: App.narrow ? Theme.sp2 : Theme.sp3;
            padding-top: Theme.sp4;
            spacing: Theme.sp3;
            alignment: start;

            Field {
                label: "Название";
                text <=> Gfx.p-name;
                supporting: "id: " + Gfx.p-id;
            }
            if Gfx.prop-errors != "": Label {
                text: Gfx.prop-errors;
                type-style: Theme.body-small;
                color: Theme.color.error;
                wrap: word-wrap;
            }

            FormSection {
                title: "Положение";
                icon: Icons.my-location;
                HorizontalLayout {
                    spacing: Theme.sp3;
                    AnchorGrid { }
                    VerticalLayout {
                        spacing: Theme.sp2;
                        HorizontalLayout {
                            spacing: Theme.sp2;
                            Field { min-width: 56px; label: "X"; text <=> Gfx.p-x; mono: true; }
                            Field { min-width: 56px; label: "Y"; text <=> Gfx.p-y; mono: true; }
                        }
                        HorizontalLayout {
                            spacing: Theme.sp2;
                            Field { min-width: 56px; label: "Ширина"; text <=> Gfx.p-w; placeholder: "авто"; mono: true; }
                            Field { min-width: 56px; label: "Высота"; text <=> Gfx.p-h; placeholder: "авто"; mono: true; }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: Theme.sp3;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        Label {
                            text: "Прозрачность: " + round(Gfx.p-opacity * 100) + "%";
                            type-style: Theme.label-medium;
                            color: Theme.color.on-surface-variant;
                        }
                        Slider {
                            minimum: 0;
                            maximum: 1;
                            step: 0.05;
                            value <=> Gfx.p-opacity;
                            value-text: round(Gfx.p-opacity * 100) + "%";
                            changed => {
                                Gfx.props-changed();
                            }
                        }
                    }
                    Select {
                        width: 170px;
                        label: "Слой";
                        options: Gfx.layer-names;
                        current-index <=> Gfx.p-layer;
                        container-color: Theme.color.surface-container-low;
                        selected => {
                            Gfx.props-changed();
                        }
                    }
                }
            }

            FormSection {
                title: "Содержимое";
                icon: Icons.edit;
                if Gfx.p-kind <= 1: Field {
                    label: Gfx.p-kind == 1 ? "Текст бегущей строки" : "Текст";
                    text <=> Gfx.p-text;
                    supporting: "{переменные} заменяются значениями в эфире";
                }
                if Gfx.p-kind <= 1: HorizontalLayout {
                    alignment: start;
                    Button {
                        text: root.show-vars ? "Скрыть переменные" : "Вставить переменную";
                        icon: root.show-vars ? Icons.expand-less : Icons.expand-more;
                        has-icon: true;
                        variant: ButtonVariant.text;
                        clicked => {
                            root.show-vars = !root.show-vars;
                        }
                    }
                }
                if Gfx.p-kind <= 1 && root.show-vars: Rectangle {
                    border-radius: Theme.radius-m;
                    background: Theme.color.surface-container;
                    VerticalLayout {
                        padding: Theme.sp1;
                        VarList {
                            insertable: true;
                            insert(v) => {
                                Gfx.insert-var(v);
                            }
                        }
                    }
                }
                if Gfx.p-kind == 1: HorizontalLayout {
                    spacing: Theme.sp2;
                    Field { label: "Скорость, px/с"; text <=> Gfx.p-speed; mono: true; }
                    Field { label: "Ширина полосы"; text <=> Gfx.p-twidth; placeholder: "весь кадр"; mono: true; }
                }
                if Gfx.p-kind == 2: Field {
                    label: "Формат времени";
                    text <=> Gfx.p-format;
                    supporting: "%H — часы, %M — минуты, %S — секунды, %d — день, %m — месяц, %Y — год. Например: %H:%M → 18:15, %d.%m.%Y → 22.10.2026";
                    mono: true;
                }
                if Gfx.p-kind == 2: Select {
                    label: "Часовой пояс";
                    options: Gfx.tz-names;
                    current-index <=> Gfx.p-tz;
                    container-color: Theme.color.surface-container-low;
                    selected => {
                        Gfx.props-changed();
                    }
                }
                if Gfx.p-kind == 3: HorizontalLayout {
                    spacing: Theme.sp2;
                    Select {
                        horizontal-stretch: 1;
                        label: "Отсчёт";
                        options: ["До конца ролика", "До следующей передачи", "До конца передачи"];
                        current-index <=> Gfx.p-target;
                        container-color: Theme.color.surface-container-low;
                        selected => {
                            Gfx.props-changed();
                        }
                    }
                    Field { horizontal-stretch: 1; label: "Префикс"; text <=> Gfx.p-prefix; }
                }
                if Gfx.p-kind == 3: Select {
                    label: "Формат";
                    options: ["Авто (1:05:09 / 05:09)", "ЧЧ:ММ:СС", "ММ:СС", "Минуты (66 мин)"];
                    current-index <=> Gfx.p-tformat;
                    container-color: Theme.color.surface-container-low;
                    selected => {
                        Gfx.props-changed();
                    }
                }
                if Gfx.p-kind == 8: HorizontalLayout {
                    spacing: Theme.sp2;
                    Select {
                        horizontal-stretch: 1;
                        label: "Показывает";
                        options: ["Ход блока / плейлиста", "Ход текущего ролика"];
                        current-index <=> Gfx.pg-target;
                        container-color: Theme.color.surface-container-low;
                        selected => {
                            Gfx.props-changed();
                        }
                    }
                    Select {
                        horizontal-stretch: 1;
                        label: "Заполнение";
                        options: ["Слева направо", "Справа налево", "Снизу вверх", "Сверху вниз"];
                        current-index <=> Gfx.pg-direction;
                        container-color: Theme.color.surface-container-low;
                        selected => {
                            Gfx.props-changed();
                        }
                    }
                }
                if Gfx.p-kind == 8: HorizontalLayout {
                    spacing: Theme.sp2;
                    Field { min-width: 56px; label: "Ширина"; text <=> Gfx.p-rw; mono: true; }
                    Field { min-width: 56px; label: "Высота"; text <=> Gfx.p-rh; mono: true; }
                    Field { min-width: 56px; label: "Скругление"; text <=> Gfx.p-radius; mono: true; }
                }
                if Gfx.p-kind == 8: ColorField { label: "Цвет заполнения"; value <=> Gfx.p-color; swatch: Gfx.sw-p-color; }
                if Gfx.p-kind == 8: ColorField { label: "Градиент заполнения до"; placeholder: "нет"; value <=> Gfx.pg-gradient; swatch: Gfx.sw-pg-gradient; }
                if Gfx.p-kind == 8: ColorField { label: "Цвет полосы"; value <=> Gfx.pg-track; swatch: Gfx.sw-pg-track; }
                if (Gfx.p-kind == 3 && Gfx.p-target == 2) || (Gfx.p-kind == 8 && Gfx.pg-target == 0): VerticalLayout {
                    spacing: Theme.sp1;
                    Label {
                        text: "Не считать в передаче";
                        type-style: Theme.label-medium;
                        color: Theme.color.on-surface-variant;
                    }
                    ToggleChips {
                        labels: ["Передачи", "Заставки", "Реклама", "Анонсы", "Заполнение", "Изображения", "Потоки"];
                        values: Gfx.p-exclude;
                        from: 0;
                        to: 3;
                        toggled(i) => {
                            Gfx.toggle-exclude(i);
                        }
                    }
                    ToggleChips {
                        labels: ["Передачи", "Заставки", "Реклама", "Анонсы", "Заполнение", "Изображения", "Потоки"];
                        values: Gfx.p-exclude;
                        from: 3;
                        to: 5;
                        toggled(i) => {
                            Gfx.toggle-exclude(i);
                        }
                    }
                    ToggleChips {
                        labels: ["Передачи", "Заставки", "Реклама", "Анонсы", "Заполнение", "Изображения", "Потоки"];
                        values: Gfx.p-exclude;
                        from: 5;
                        to: 7;
                        toggled(i) => {
                            Gfx.toggle-exclude(i);
                        }
                    }
                    Label {
                        text: "Передача — блок сетки, в котором идёт текущий ролик. Время отмеченных вставок (например, рекламы внутри передачи) не входит в отсчёт.";
                        wrap: word-wrap;
                        type-style: Theme.body-small;
                        color: Theme.color.on-surface-variant;
                    }
                }
                if Gfx.p-kind == 4: HorizontalLayout {
                    spacing: Theme.sp2;
                    Field {
                        horizontal-stretch: 1;
                        label: "Файл графики / анимации";
                        text <=> Gfx.p-path;
                        supporting: "PNG / JPEG / WebP / HTML / SWF. Для HTML и SWF задайте ширину и высоту. Нужен Edge / Chrome; SWF — Ruffle (интернет или локальный пакет).";
                    }
                    VerticalLayout {
                        alignment: start;
                        padding-top: 4px;
                        Button {
                            text: "Обзор…";
                            icon: Icons.folder-open;
                            has-icon: true;
                            variant: ButtonVariant.tonal;
                            tooltip: "Выбрать файл на этом компьютере";
                            clicked => {
                                Gfx.pick-image();
                            }
                        }
                    }
                }
                if Gfx.p-kind == 5: ColorField {
                    label: "Цвет плашки";
                    value <=> Gfx.p-color;
                    swatch: Gfx.sw-p-color;
                }
                if Gfx.p-kind == 5: HorizontalLayout {
                    spacing: Theme.sp2;
                    Field { min-width: 56px; label: "Ширина"; text <=> Gfx.p-rw; mono: true; }
                    Field { min-width: 56px; label: "Высота"; text <=> Gfx.p-rh; mono: true; }
                    Field { min-width: 56px; label: "Скругление"; text <=> Gfx.p-radius; mono: true; }
                }
                if Gfx.p-kind == 6: Field {
                    label: "Элементы группы (id через запятую)";
                    text <=> Gfx.p-children;
                }
                if Gfx.p-kind == 7: Label {
                    text: "Плашка растёт по тексту своих строк. Строки и фон — ниже, вид выбранной строки — в разделе «Текст строки».";
                    wrap: word-wrap;
                    type-style: Theme.body-small;
                    color: Theme.color.on-surface-variant;
                }
            }

            if Gfx.p-kind == 7: PlateSection { }
            if Gfx.p-kind == 7: HorizontalLayout {
                alignment: start;
                Button {
                    text: root.show-vars ? "Скрыть переменные" : "Вставить переменную в строку";
                    icon: root.show-vars ? Icons.expand-less : Icons.expand-more;
                    has-icon: true;
                    variant: ButtonVariant.text;
                    clicked => {
                        root.show-vars = !root.show-vars;
                    }
                }
            }
            if Gfx.p-kind == 7 && root.show-vars: Rectangle {
                border-radius: Theme.radius-m;
                background: Theme.color.surface-container;
                VerticalLayout {
                    padding: Theme.sp1;
                    VarList {
                        insertable: true;
                        insert(v) => {
                            Gfx.insert-var(v);
                        }
                    }
                }
            }
            if Gfx.p-kind == 5 || Gfx.p-kind == 7 || Gfx.p-kind == 8: ShapeSection { }

            if Gfx.p-kind <= 3 || Gfx.p-kind == 7: TextStyleSection { }

            FormSection {
                title: "Анимация";
                icon: Icons.animation;
                HorizontalLayout {
                    spacing: Theme.sp2;
                    Select {
                        horizontal-stretch: 1;
                        label: "Появление";
                        options: Gfx.anim-in-names;
                        current-index <=> Gfx.a-in;
                        container-color: Theme.color.surface-container-low;
                        selected => {
                            Gfx.props-changed();
                        }
                    }
                    Select {
                        horizontal-stretch: 1;
                        label: "Исчезновение";
                        options: Gfx.anim-out-names;
                        current-index <=> Gfx.a-out;
                        container-color: Theme.color.surface-container-low;
                        selected => {
                            Gfx.props-changed();
                        }
                    }
                }
                Field { label: "Длительность, мс"; text <=> Gfx.a-ms; mono: true; supporting: "обычно 300–800; для пружины и прыжка — 600–1000"; }
            }

            Field {
                label: "Профили";
                text <=> Gfx.p-profiles;
                supporting: "пусто — во всех профилях выхода";
            }
        }
    }
}
