// On-screen graphics editor: canvas | layers | properties; tabs for
// display rules, variables and design templates.

import { Theme } from "../../theme/tokens.slint";
import { Icons } from "../../theme/icons.slint";
import { Label } from "../../components/label.slint";
import { SegmentedButton } from "../../components/segmented-button.slint";
import { Button, ButtonVariant } from "../../components/button.slint";
import { IconButton } from "../../components/icon-button.slint";
import { StatusChip, StatusTone } from "../../components/indicators.slint";
import { Page, PageHeader } from "../../shell/page.slint";
import { Gfx } from "../../state/graphics-state.slint";
import { App } from "../../state/app-state.slint";
import { GfxCanvas } from "canvas.slint";
import { GfxToolbar } from "toolbar.slint";
import { LayersPanel } from "layers.slint";
import { PropertiesPanel } from "properties.slint";
import { GfxRulesTab, GfxVarsTab, GfxTemplatesTab } from "extra-tabs.slint";

component GfxTabs inherits SegmentedButton {
    width: 480px;
    segments: [{ text: "Холст", icon: Icons.branding-watermark, has-icon: true }, { text: "Правила" }, { text: "Переменные" }, { text: "Шаблоны" }];
    selected <=> Gfx.tab;
}

export component GraphicsScreen inherits Page {
    VerticalLayout {
        padding: Theme.sp4;
        spacing: Theme.sp3;

        PageHeader {
            title: "Экранная графика";
            if !App.narrow: GfxTabs { }
            if Gfx.dirty: VerticalLayout {
                alignment: center;
                StatusChip {
                    text: "Не сохранено";
                    tone: StatusTone.warning;
                    icon: Icons.edit;
                }
            }
            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: Icons.undo;
                    enabled: Gfx.can-undo;
                    tooltip: "Отменить (Ctrl+Z)";
                    clicked => {
                        Gfx.undo();
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: Icons.redo;
                    enabled: Gfx.can-redo;
                    tooltip: "Повторить (Ctrl+Y)";
                    clicked => {
                        Gfx.redo();
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                Button {
                    text: "Сбросить";
                    variant: ButtonVariant.text;
                    enabled: Gfx.dirty;
                    clicked => {
                        Gfx.revert();
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                Button {
                    text: "Сохранить";
                    icon: Icons.save;
                    has-icon: true;
                    enabled: Gfx.dirty;
                    tooltip: "Ctrl+S";
                    clicked => {
                        Gfx.save();
                    }
                }
            }
        }

        if App.narrow: HorizontalLayout {
            GfxTabs { }
            Rectangle {
                horizontal-stretch: 1;
            }
        }

        if Gfx.tab == 0: HorizontalLayout {
            vertical-stretch: 1;
            spacing: Theme.sp3;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: Theme.sp2;
                GfxToolbar { }
                GfxCanvas {
                    vertical-stretch: 1;
                    min-height: 240px;
                }
                if Gfx.bg-note != "": Label {
                    text: Gfx.bg-note;
                    type-style: Theme.body-small;
                    color: Theme.color.on-surface-variant;
                    wrap: word-wrap;
                }
                LayersPanel {
                    height: 220px;
                }
            }
            PropertiesPanel {
                width: App.narrow ? 300px : clamp(root.width * 0.3, 300px, 400px);
            }
        }
        if Gfx.tab == 1: GfxRulesTab {
            vertical-stretch: 1;
        }
        if Gfx.tab == 2: GfxVarsTab {
            vertical-stretch: 1;
        }
        if Gfx.tab == 3: GfxTemplatesTab {
            vertical-stretch: 1;
        }
    }
}
