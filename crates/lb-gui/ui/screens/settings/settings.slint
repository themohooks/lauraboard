import { Select } from "../../components/select.slint";
import { TextField } from "../../components/text-field.slint";
// Settings: appearance (theme, scale, density, motion, navigation), layout
// reset, connection info, keyboard shortcuts, about.

import { ScrollView, AboutSlint } from "std-widgets.slint";
import { Theme } from "../../theme/tokens.slint";
import { Icons } from "../../theme/icons.slint";
import { Label } from "../../components/label.slint";
import { Icon } from "../../components/icon.slint";
import { Card, CardHeader, CardStyle } from "../../components/card.slint";
import { SegmentedButton } from "../../components/segmented-button.slint";
import { Slider } from "../../components/slider.slint";
import { Switch } from "../../components/switch.slint";
import { Button, ButtonVariant } from "../../components/button.slint";
import { StatusChip, StatusTone } from "../../components/indicators.slint";
import { Page, PageHeader } from "../../shell/page.slint";
import { Settings } from "../../state/settings-state.slint";
import { Upd } from "../../state/update-state.slint";
import { LinearProgress } from "../../components/feedback.slint";

component Setting inherits HorizontalLayout {
    in property <string> title;
    in property <string> hint;
    spacing: Theme.sp4;
    VerticalLayout {
        width: 220px;
        alignment: center;
        Label {
            text: root.title;
            type-style: Theme.title-small;
        }
        if root.hint != "": Label {
            text: root.hint;
            type-style: Theme.body-small;
            color: Theme.color.on-surface-variant;
            wrap: word-wrap;
        }
    }
    @children
}

component Row inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <bool> mono;
    spacing: Theme.sp3;
    Label {
        width: 220px;
        text: root.label;
        color: Theme.color.on-surface-variant;
    }
    Label {
        horizontal-stretch: 1;
        text: root.value;
        mono: root.mono;
        wrap: word-wrap;
    }
}

component Key inherits HorizontalLayout {
    in property <string> keys;
    in property <string> action;
    spacing: Theme.sp3;
    VerticalLayout {
        width: 220px;
        alignment: center;
        HorizontalLayout {
            alignment: start;
            Rectangle {
                border-radius: Theme.radius-xs;
                background: Theme.color.surface-container-highest;
                border-width: 1px;
                border-color: Theme.color.outline-variant;
                HorizontalLayout {
                    padding-left: Theme.sp2;
                    padding-right: Theme.sp2;
                    padding-top: 2px;
                    padding-bottom: 2px;
                    Label {
                        text: root.keys;
                        mono: true;
                        type-style: Theme.label-medium;
                    }
                }
            }
        }
    }
    Label {
        horizontal-stretch: 1;
        text: root.action;
        vertical-alignment: center;
    }
}

component ScalePreset inherits Button {
    in property <int> percent;
    text: percent + "%";
    variant: Settings.scale == percent ? ButtonVariant.tonal : ButtonVariant.text;
    clicked => {
        Settings.scale = root.percent;
        Settings.scale-changed(root.percent);
    }
}

export component SettingsScreen inherits Page {
    sv := ScrollView {
        HorizontalLayout {
            width: sv.visible-width;
            alignment: center;
            VerticalLayout {
                width: min(sv.visible-width, 880px);
                padding: Theme.sp4;
                spacing: Theme.sp3;
                alignment: start;

                PageHeader {
                    title: "Настройки";
                    subtitle: "Интерфейс и параметры предпросмотра выбранного канала";
                }

                Card {
                    card-style: CardStyle.low;
                    CardHeader {
                        title: "Обновления";
                        subtitle: "Версия " + Upd.current + (Upd.status != "" ? " · " + Upd.status : "");
                        if Upd.phase != "checking" && Upd.phase != "downloading": Button {
                            text: "Проверить";
                            variant: ButtonVariant.text;
                            icon: Icons.refresh;
                            has-icon: true;
                            clicked => {
                                Upd.check();
                            }
                        }
                    }
                    if Upd.phase == "checking": LinearProgress {
                        indeterminate: true;
                    }
                    if Upd.phase == "available" || Upd.phase == "downloading" || Upd.phase == "ready": VerticalLayout {
                        spacing: Theme.sp2;
                        HorizontalLayout {
                            spacing: Theme.sp2;
                            Icon {
                                source: Icons.upgrade;
                                tint: Theme.color.primary;
                            }
                            Label {
                                horizontal-stretch: 1;
                                text: "Доступна версия " + Upd.latest + (Upd.skipped ? " (пропущена)" : "");
                                type-style: Theme.title-small;
                                vertical-alignment: center;
                            }
                        }
                        if Upd.notes != "": Label {
                            text: Upd.notes;
                            type-style: Theme.body-small;
                            color: Theme.color.on-surface-variant;
                            wrap: word-wrap;
                        }
                        if Upd.phase == "downloading": LinearProgress {
                            progress: Upd.progress;
                        }
                        Label {
                            text: Upd.install-hint;
                            type-style: Theme.body-small;
                            color: Theme.color.on-surface-variant;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: Theme.sp2;
                            alignment: start;
                            Button {
                                text: Upd.install-label;
                                icon: Icons.upgrade;
                                has-icon: true;
                                variant: ButtonVariant.filled;
                                enabled: Upd.phase != "downloading";
                                clicked => {
                                    Upd.install();
                                }
                            }
                            Button {
                                text: "Что нового";
                                variant: ButtonVariant.text;
                                clicked => {
                                    Upd.open-page();
                                }
                            }
                            if !Upd.skipped && Upd.phase == "available": Button {
                                text: "Пропустить эту версию";
                                variant: ButtonVariant.text;
                                clicked => {
                                    Upd.skip();
                                }
                            }
                        }
                    }
                    Setting {
                        title: "Проверять автоматически";
                        hint: "Раз в день, тихо: только значок в верхней панели. Без вашего согласия ничего не скачивается";
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Switch {
                                text: "Искать новые версии на GitHub";
                                checked: Upd.auto;
                                toggled(v) => {
                                    Upd.auto-changed(v);
                                }
                            }
                        }
                    }
                }

                Card {
                    card-style: CardStyle.low;
                    CardHeader { title: "Частота кадров предпросмотра"; subtitle: "Пресеты и синхронизация с монитором. Частота выходного видео сохраняется."; }
                    Select { label: "Режим"; options: Settings.preview-options; current-index <=> Settings.preview-preset;
                        selected(i, _) => { Settings.preview-selected(i); }
                    }
                    TextField { label: "FPS (10–360)"; text <=> Settings.preview-fps;
                        enabled: Settings.preview-preset == Settings.preview-options.length - 1;
                    }
                    Label { text: Settings.preview-info; wrap: word-wrap; color: Theme.color.on-surface-variant; }
                    Label { text: "Изменение частоты источника перезапускает кодировщик. Режимы монитора автоматически учитывают экран, на котором находится окно."; wrap: word-wrap; color: Theme.color.on-surface-variant; }
                    Button { text: "Применить"; clicked => { Settings.preview-save(); } }
                }
                Card {
                    card-style: CardStyle.low;
                    CardHeader { title: "Ретрансляция в локальную сеть"; subtitle: "Эфир выбранного канала в HLS (m3u8). У каждого канала должен быть свой свободный порт."; }
                    Switch { text: "Раздавать эфир по локальной сети"; checked <=> Settings.hls-enabled; enabled: Settings.hls-can-edit; }
                    TextField { label: "Порт HTTP"; text <=> Settings.hls-port; enabled: Settings.hls-can-edit; }
                    TextField { label: "Адрес плейлиста"; text: Settings.hls-url; read-only: true; }
                    Label { text: "На другом устройстве замените адрес на IP компьютера вещания. Поток доступен без пароля всем устройствам, имеющим доступ к этому порту."; wrap: word-wrap; color: Theme.color.on-surface-variant; }
                    Button { text: "Применить"; enabled: Settings.hls-can-edit; clicked => { Settings.hls-save(); } }
                }
                Card {
                    card-style: CardStyle.low;
                    gap: Theme.sp4;
                    CardHeader {
                        title: "Оформление";
                    }
                    Setting {
                        title: "Тема";
                        hint: "«Системная» следует настройке ОС";
                        SegmentedButton {
                            horizontal-stretch: 1;
                            segments: [
                                { text: "Системная", icon: Icons.contrast, has-icon: true },
                                { text: "Светлая", icon: Icons.light-mode, has-icon: true },
                                { text: "Тёмная", icon: Icons.dark-mode, has-icon: true },
                            ];
                            selected <=> Settings.theme;
                            changed(i) => {
                                Settings.theme-changed(i);
                            }
                        }
                    }
                    Setting {
                        title: "Масштаб: " + Settings.scale + "%";
                        hint: "Поверх масштаба экрана в ОС";
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: Theme.sp2;
                            Slider {
                                minimum: 80;
                                maximum: 200;
                                step: 5;
                                value: Settings.scale;
                                value-text: Settings.scale + "%";
                                changed(v) => {
                                    Settings.scale = round(v);
                                    Settings.scale-changed(round(v));
                                }
                            }
                            HorizontalLayout {
                                spacing: Theme.sp2;
                                alignment: start;
                                ScalePreset { percent: 100; }
                                ScalePreset { percent: 125; }
                                ScalePreset { percent: 150; }
                                ScalePreset { percent: 175; }
                                ScalePreset { percent: 200; }
                            }
                        }
                    }
                    Setting {
                        title: "Плотность";
                        hint: "Компактные строки списков и таблиц";
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Switch {
                                text: "Компактный режим";
                                checked <=> Settings.compact;
                                toggled(v) => {
                                    Settings.compact-changed(v);
                                }
                            }
                        }
                    }
                    Setting {
                        title: "Анимации";
                        hint: Settings.motion == 0 ? (Settings.system-reduce-motion ? "Сейчас выключены в ОС" : "Сейчас включены в ОС") : "";
                        SegmentedButton {
                            horizontal-stretch: 1;
                            segments: [{ text: "Как в системе" }, { text: "Включены" }, { text: "Выключены" }];
                            selected <=> Settings.motion;
                            changed(i) => {
                                Settings.motion-changed(i);
                            }
                        }
                    }
                    Setting {
                        title: "Навигация";
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Switch {
                                text: "Панель разделов с подписями";
                                checked <=> Settings.nav-expanded;
                                toggled(v) => {
                                    Settings.nav-changed(v);
                                }
                            }
                        }
                    }
                    Setting {
                        title: "Закрытие окна";
                        hint: Settings.has-tray ? "Эфир продолжается в фоне; окно открывается щелчком по значку в трее, выход — из его меню"
                            : "Значок в трее недоступен в этой системе — крестик завершает программу";
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Switch {
                                text: "Сворачивать в трей вместо выхода";
                                enabled: Settings.has-tray;
                                checked <=> Settings.close-to-tray;
                                toggled(v) => {
                                    Settings.close-to-tray-changed(v);
                                }
                            }
                        }
                    }
                }

                Card {
                    card-style: CardStyle.low;
                    CardHeader {
                        title: "Уведомления";
                        subtitle: "Всплывающие карточки в углу экрана с аватаром канала — видны поверх других окон, даже когда программа свёрнута в трей, и не забирают фокус";
                        Button {
                            text: "Проверить";
                            variant: ButtonVariant.text;
                            icon: Icons.campaign;
                            has-icon: true;
                            clicked => {
                                Settings.notify-test();
                            }
                        }
                    }
                    Setting {
                        title: "Показывать";
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Switch {
                                text: "Уведомления включены";
                                checked: Settings.notify[0];
                                toggled(v) => {
                                    Settings.notify-changed(0, v);
                                }
                            }
                        }
                    }
                    Setting {
                        title: "О чём";
                        hint: "Одинаковое уведомление не повторяется чаще раза в минуту";
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: Theme.sp2;
                            for item[i] in [
                                "Сбои: кодировщик остановлен и восстановлен, нет связи с сервером",
                                "Пропущенные ролики (нет файла, ошибка чтения)",
                                "Недоступные точки вещания (RTMP, SRT…)",
                                "Мало места на диске для записи (меньше 5 ГБ)",
                                "Эфир запущен / остановлен, ручной режим",
                                "Каждая новая передача в эфире",
                                "Только когда окно свёрнуто или скрыто",
                            ]: Switch {
                                text: item;
                                enabled: Settings.notify[0];
                                checked: Settings.notify[i + 1];
                                toggled(v) => {
                                    Settings.notify-changed(i + 1, v);
                                }
                            }
                        }
                    }
                }

                Card {
                    card-style: CardStyle.low;
                    CardHeader {
                        title: "Компоновка";
                        subtitle: "Ширина панелей, вид медиатеки и навигации сохраняются между запусками";
                    }
                    HorizontalLayout {
                        spacing: Theme.sp2;
                        alignment: start;
                        Button {
                            text: "Сбросить компоновку";
                            icon: Icons.undo;
                            has-icon: true;
                            variant: ButtonVariant.tonal;
                            clicked => {
                                Settings.reset-layout();
                            }
                        }
                        Button {
                            text: "Сбросить все настройки…";
                            variant: ButtonVariant.text;
                            clicked => {
                                Settings.reset-all();
                            }
                        }
                    }
                    Label {
                        text: "Файл настроек: " + Settings.prefs-path;
                        type-style: Theme.body-small;
                        color: Theme.color.on-surface-variant;
                        wrap: word-wrap;
                    }
                }

                Card {
                    card-style: CardStyle.low;
                    CardHeader {
                        title: "Подключение";
                        StatusChip {
                            text: Settings.online ? "Связь есть" : "Нет связи";
                            tone: Settings.online ? StatusTone.success : StatusTone.error;
                        }
                    }
                    Row { label: "Сервер API"; value: Settings.api-url; mono: true; }
                    Row { label: "Каналы"; value: Settings.channels; }
                    Row { label: "Версия сервера"; value: Settings.server-version; }
                    Label {
                        text: "Интерфейс — отдельный клиент: его закрытие или перезапуск не прерывает эфир. Параметры канала (выходы, кодирование, ключи трансляции) задаются в channels/<канал>/channel.toml или через API с ролью администратора.";
                        type-style: Theme.body-small;
                        color: Theme.color.on-surface-variant;
                        wrap: word-wrap;
                    }
                }

                Card {
                    card-style: CardStyle.low;
                    gap: Theme.sp2;
                    CardHeader {
                        title: "Горячие клавиши";
                    }
                    Key { keys: "Ctrl+1 … Ctrl+0"; action: "Первые десять разделов по порядку"; }
                    Key { keys: "Ctrl+S"; action: "Сохранить изменения на экране"; }
                    Key { keys: "Ctrl+Z / Ctrl+Y"; action: "Отменить / повторить (также Ctrl+Shift+Z)"; }
                    Key { keys: "Ctrl+F"; action: "Поиск"; }
                    Key { keys: "Delete"; action: "Удалить выбранное"; }
                    Key { keys: "F5"; action: "Обновить данные с сервера"; }
                    Key { keys: "F11"; action: "Монитор эфира на весь экран"; }
                    Key { keys: "Esc"; action: "Закрыть диалог или панель"; }
                }

                Card {
                    card-style: CardStyle.low;
                    CardHeader {
                        title: "О программе";
                        subtitle: "LauraBoard " + Settings.app-version + " — плейаут интернет-телеканала";
                    }
                    Label {
                        text: "Иконки Material Symbols (Apache 2.0), шрифты Roboto и Roboto Mono (OFL).";
                        type-style: Theme.body-small;
                        color: Theme.color.on-surface-variant;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        alignment: start;
                        AboutSlint {
                            preferred-height: 120px;
                        }
                    }
                }
            }
        }
    }
}
