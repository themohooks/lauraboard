// Media library screen: toolbar | table or tiles | edit sheet.

import { Theme } from "../../theme/tokens.slint";
import { Page, PageHeader } from "../../shell/page.slint";
import { LibraryToolbar } from "toolbar.slint";
import { MediaTable } from "media-table.slint";
import { MediaEditSheet } from "edit-sheet.slint";

export component LibraryScreen inherits Page {
    // The sheet sits on top at the right edge instead of sharing a layout:
    // content that cannot shrink any further goes under the sheet rather
    // than pushing it out of the window.
    VerticalLayout {
        x: 0;
        y: 0;
        width: root.width - sheet.width;
        height: root.height;
        padding: Theme.sp4;
        spacing: Theme.sp3;
        LibraryToolbar { }
        MediaTable {
            vertical-stretch: 1;
        }
    }
    sheet := MediaEditSheet {
        x: root.width - self.width;
        y: 0;
        height: root.height;
    }
}
