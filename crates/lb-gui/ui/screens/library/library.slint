// Media library screen: folders | toolbar + table or tiles | edit sheet.

import { Theme } from "../../theme/tokens.slint";
import { App } from "../../state/app-state.slint";
import { Lib } from "../../state/library-state.slint";
import { Page, PageHeader } from "../../shell/page.slint";
import { LibraryToolbar } from "toolbar.slint";
import { MediaTable } from "media-table.slint";
import { MediaEditSheet } from "edit-sheet.slint";
import { FolderPanel } from "folder-panel.slint";

export component LibraryScreen inherits Page {
    // The sheet sits on top at the right edge instead of sharing a layout:
    // content that cannot shrink any further goes under the sheet rather
    // than pushing it out of the window.
    HorizontalLayout {
        x: 0;
        y: 0;
        width: root.width - sheet.width;
        height: root.height;
        padding: Theme.sp4;
        spacing: Theme.sp4;
        // narrow window: a narrower panel, hidden from the toolbar if needed
        if Lib.folders-shown: FolderPanel {
            width: App.narrow ? 180px : 230px;
        }
        VerticalLayout {
            spacing: Theme.sp3;
            LibraryToolbar { }
            MediaTable {
                vertical-stretch: 1;
            }
        }
    }
    sheet := MediaEditSheet {
        x: root.width - self.width;
        y: 0;
        height: root.height;
    }
}
