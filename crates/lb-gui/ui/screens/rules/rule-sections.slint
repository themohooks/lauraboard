// Rule form split into the four steps of the wizard: when, what,
// conditions, limits. Used both by the editor and by the wizard.

import { Theme } from "../../theme/tokens.slint";
import { Icons } from "../../theme/icons.slint";
import { Label } from "../../components/label.slint";
import { TextField } from "../../components/text-field.slint";
import { Select } from "../../components/select.slint";
import { Switch } from "../../components/switch.slint";
import { Radio } from "../../components/checkbox.slint";
import { Slider } from "../../components/slider.slint";
import { Rules } from "../../state/rules-state.slint";
import { FormSection, ToggleChips } from "form-parts.slint";
import { MediaPickList } from "media-list.slint";
import { Button, ButtonVariant } from "../../components/button.slint";
import { IconButton } from "../../components/icon-button.slint";

export component WhenSection inherits FormSection {
    in property <color> field-bg: Theme.color.surface-container-low;
    title: "Когда";
    hint: "событие, по которому срабатывает правило";
    icon: Icons.schedule;
    HorizontalLayout {
        spacing: Theme.sp3;
        Select {
            horizontal-stretch: 1;
            label: "Триггер";
            options: ["Каждые N роликов", "Каждые N минут", "В начале блока", "В конце блока", "Между блоками", "После категории", "Перед категорией", "После роликов", "После плейлиста", "В заданное время"];
            current-index <=> Rules.f-trigger;
            container-color: root.field-bg;
            selected => {
                Rules.form-changed();
            }
        }
        if Rules.f-trigger == 0: TextField {
            width: 140px;
            label: "Роликов";
            text <=> Rules.f-n;
            error: Rules.e-n;
            container-color: root.field-bg;
            edited => {
                Rules.form-changed();
            }
        }
        if Rules.f-trigger == 1: TextField {
            width: 140px;
            label: "Минут";
            text <=> Rules.f-minutes;
            error: Rules.e-minutes;
            container-color: root.field-bg;
            edited => {
                Rules.form-changed();
            }
        }
        if Rules.f-trigger == 5 || Rules.f-trigger == 6: TextField {
            horizontal-stretch: 1;
            label: "Категория";
            text <=> Rules.f-tcat;
            placeholder: "news";
            container-color: root.field-bg;
            edited => {
                Rules.form-changed();
            }
        }
        if Rules.f-trigger == 8: Select {
            horizontal-stretch: 1;
            label: "Плейлист";
            options: Rules.playlists;
            current-index <=> Rules.f-tpl;
            placeholder: "Выберите плейлист";
            container-color: root.field-bg;
            selected => {
                Rules.form-changed();
            }
        }
        if Rules.f-trigger == 9: TextField {
            horizontal-stretch: 1;
            label: "Время";
            text <=> Rules.f-times;
            error: Rules.e-times;
            placeholder: "12:00, 18:30";
            supporting: "после первого ролика, который закончится в это время или позже";
            mono: true;
            container-color: root.field-bg;
            edited => {
                Rules.form-changed();
            }
        }
    }
    if Rules.f-trigger == 8: Label {
        text: "Срабатывает каждый раз, когда в эфире заканчивается последний ролик плейлиста.";
        wrap: word-wrap;
        type-style: Theme.body-small;
        color: Theme.color.on-surface-variant;
    }
    if Rules.f-trigger == 7: HorizontalLayout {
        spacing: Theme.sp2;
        Label {
            horizontal-stretch: 1;
            vertical-alignment: center;
            text: Rules.f-tmedia.length > 0 ? "Вставлять после любого из роликов: " + Rules.f-tmedia.length : "Выберите ролики, после которых срабатывает правило";
            color: Theme.color.on-surface-variant;
            wrap: word-wrap;
        }
        if Rules.f-tmedia.length > 0: Button {
            text: "Очистить";
            variant: ButtonVariant.text;
            clicked => {
                Rules.trigger-item("clear", 0);
            }
        }
        Button {
            text: "Выбрать из медиатеки";
            variant: ButtonVariant.tonal;
            icon: Icons.video-library;
            has-icon: true;
            clicked => {
                Rules.pick("trigger-media");
            }
        }
    }
    if Rules.f-trigger == 7 && Rules.f-tmedia.length > 0: MediaPickList {
        items: Rules.f-tmedia;
        row-bg: root.field-bg;
        action(a, i) => {
            Rules.trigger-item(a, i);
        }
    }
}

export component WhatSection inherits FormSection {
    in property <color> field-bg: Theme.color.surface-container-low;
    title: Rules.scope == "scenes" ? "Какую сцену" : "Что вставить";
    icon: Icons.playlist-add;
    if Rules.scope == "scenes": HorizontalLayout {
        spacing: Theme.sp3;
        TextField {
            width: 200px;
            label: "Длительность";
            text <=> Rules.f-sdur;
            error: Rules.e-sdur;
            placeholder: "своя у сцены";
            supporting: "ЧЧ:ММ:СС";
            mono: true;
            container-color: root.field-bg;
            edited => {
                Rules.form-changed();
            }
        }
        Label {
            horizontal-stretch: 1;
            vertical-alignment: center;
            text: Rules.f-media.length > 0 ? "Сцен: " + Rules.f-media.length + (Rules.f-random ? " (случайная)" : " (по очереди)") : "Сцены не выбраны — подойдёт любая сцена медиатеки";
            color: Theme.color.on-surface-variant;
            wrap: word-wrap;
        }
        if Rules.f-media.length > 0: Button {
            text: "Очистить";
            variant: ButtonVariant.text;
            clicked => {
                Rules.rule-item("clear", 0);
            }
        }
        Button {
            text: "Выбрать сцены";
            variant: ButtonVariant.tonal;
            icon: Icons.live-tv;
            has-icon: true;
            clicked => {
                Rules.pick("rule-items");
            }
        }
    }
    if Rules.scope == "scenes" && Rules.f-media.length > 0: MediaPickList {
        items: Rules.f-media;
        row-bg: root.field-bg;
        action(a, i) => {
            Rules.rule-item(a, i);
        }
    }
    if Rules.scope != "scenes": HorizontalLayout {
        spacing: Theme.sp3;
        Select {
            width: 200px;
            label: "Действие";
            options: ["Заставка", "Рекламный блок", "Анонсы", "Ролик"];
            current-index <=> Rules.f-action;
            container-color: root.field-bg;
            selected => {
                Rules.form-changed();
            }
        }
        if Rules.f-action == 0: TextField {
            horizontal-stretch: 1;
            label: "Категория заставок";
            text <=> Rules.f-jcat;
            placeholder: "idents";
            supporting: "или перечислите ролики ниже";
            container-color: root.field-bg;
            edited => {
                Rules.form-changed();
            }
        }
        if Rules.f-action == 1: Select {
            horizontal-stretch: 1;
            label: "Рекламный блок";
            options: Rules.ad-breaks;
            current-index <=> Rules.f-ab;
            placeholder: "Создайте блок на вкладке «Рекламные блоки»";
            container-color: root.field-bg;
            selected => {
                Rules.form-changed();
            }
        }
        if Rules.f-action == 2: TextField {
            width: 140px;
            label: "Сколько анонсов";
            text <=> Rules.f-pcount;
            error: Rules.e-pcount;
            container-color: root.field-bg;
            edited => {
                Rules.form-changed();
            }
        }
        if Rules.f-action == 2: TextField {
            horizontal-stretch: 1;
            label: "Категория анонсов";
            text <=> Rules.f-pcat;
            placeholder: "любые актуальные";
            container-color: root.field-bg;
            edited => {
                Rules.form-changed();
            }
        }
    }
    if Rules.scope != "scenes" && (Rules.f-action == 0 || Rules.f-action == 3): HorizontalLayout {
        spacing: Theme.sp2;
        Label {
            horizontal-stretch: 1;
            vertical-alignment: center;
            text: Rules.f-media.length > 0 ? (Rules.f-action == 0 ? "Заставок: " : "Роликов (выбирается один): ") + Rules.f-media.length
                : Rules.f-action == 0 ? "Конкретные заставки не выбраны — берутся из категории" : "Выберите ролики — в эфир пойдёт один из них";
            color: Theme.color.on-surface-variant;
            wrap: word-wrap;
        }
        if Rules.f-media.length > 0: Button {
            text: "Очистить";
            variant: ButtonVariant.text;
            clicked => {
                Rules.rule-item("clear", 0);
            }
        }
        Button {
            text: "Выбрать из медиатеки";
            variant: ButtonVariant.tonal;
            icon: Icons.video-library;
            has-icon: true;
            clicked => {
                Rules.pick("rule-items");
            }
        }
    }
    if Rules.scope != "scenes" && (Rules.f-action == 0 || Rules.f-action == 3) && Rules.f-media.length > 0: MediaPickList {
        items: Rules.f-media;
        row-bg: root.field-bg;
        action(a, i) => {
            Rules.rule-item(a, i);
        }
    }
}

export component ConditionsSection inherits FormSection {
    in property <color> field-bg: Theme.color.surface-container-low;
    title: "Условия";
    hint: "пусто — без ограничений";
    icon: Icons.filter-list;
    HorizontalLayout {
        spacing: Theme.sp3;
        TextField {
            horizontal-stretch: 1;
            label: "Только для категорий";
            text <=> Rules.f-cats;
            container-color: root.field-bg;
            edited => {
                Rules.form-changed();
            }
        }
        TextField {
            horizontal-stretch: 1;
            label: "Кроме категорий";
            text <=> Rules.f-xcats;
            container-color: root.field-bg;
            edited => {
                Rules.form-changed();
            }
        }
    }
    HorizontalLayout {
        spacing: Theme.sp3;
        TextField {
            horizontal-stretch: 1;
            label: "Только в блоках (id)";
            text <=> Rules.f-blocks;
            container-color: root.field-bg;
            edited => {
                Rules.form-changed();
            }
        }
        TextField {
            horizontal-stretch: 1;
            label: "Только в плейлистах";
            text <=> Rules.f-playlists;
            container-color: root.field-bg;
            edited => {
                Rules.form-changed();
            }
        }
        TextField {
            horizontal-stretch: 1;
            label: "Кроме роликов";
            text <=> Rules.f-xmedia;
            container-color: root.field-bg;
            edited => {
                Rules.form-changed();
            }
        }
        VerticalLayout {
            alignment: start;
            padding-top: 4px;
            IconButton {
                icon: Icons.video-library;
                tooltip: "Выбрать из медиатеки";
                clicked => {
                    Rules.pick("rule-exclude");
                }
            }
        }
    }
    Label {
        text: "Типы контента, после которых срабатывает";
        type-style: Theme.label-medium;
        color: Theme.color.on-surface-variant;
    }
    ToggleChips {
        labels: ["Передачи", "Заставки", "Реклама", "Анонсы", "Заполнение", "Изображения", "Потоки"];
        values: Rules.f-kinds;
        to: 4;
        toggled(i) => {
            Rules.toggle-kind(i);
        }
    }
    ToggleChips {
        labels: ["Передачи", "Заставки", "Реклама", "Анонсы", "Заполнение", "Изображения", "Потоки"];
        values: Rules.f-kinds;
        from: 4;
        toggled(i) => {
            Rules.toggle-kind(i);
        }
    }
    Label {
        text: "Дни недели и часы";
        type-style: Theme.label-medium;
        color: Theme.color.on-surface-variant;
    }
    ToggleChips {
        labels: ["Пн", "Вт", "Ср", "Чт", "Пт", "Сб", "Вс"];
        values: Rules.f-weekdays;
        toggled(i) => {
            Rules.toggle-weekday(i);
        }
    }
    HorizontalLayout {
        spacing: Theme.sp3;
        alignment: start;
        TextField {
            width: 110px;
            label: "С";
            placeholder: "ЧЧ:ММ";
            mono: true;
            text <=> Rules.f-from;
            error: Rules.e-from;
            container-color: root.field-bg;
            edited => {
                Rules.form-changed();
            }
        }
        TextField {
            width: 110px;
            label: "До";
            placeholder: "ЧЧ:ММ";
            mono: true;
            text <=> Rules.f-to;
            error: Rules.e-to;
            container-color: root.field-bg;
            edited => {
                Rules.form-changed();
            }
        }
    }
}

export component LimitsSection inherits FormSection {
    in property <color> field-bg: Theme.color.surface-container-low;
    title: "Ограничения и приоритет";
    icon: Icons.tune;
    HorizontalLayout {
        spacing: Theme.sp4;
        alignment: start;
        Radio {
            text: "По очереди";
            checked: !Rules.f-random;
            clicked => {
                Rules.f-random = false;
                Rules.form-changed();
            }
        }
        Radio {
            text: "Случайно";
            checked: Rules.f-random;
            clicked => {
                Rules.f-random = true;
                Rules.form-changed();
            }
        }
        Switch {
            text: "Без повтора подряд";
            checked <=> Rules.f-norepeat;
            toggled => {
                Rules.form-changed();
            }
        }
    }
    HorizontalLayout {
        spacing: Theme.sp3;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 0;
            Label {
                text: "Вероятность: " + round(Rules.f-prob * 100) + "%";
                type-style: Theme.label-medium;
                color: Theme.color.on-surface-variant;
            }
            Slider {
                minimum: 0;
                maximum: 1;
                step: 0.05;
                value <=> Rules.f-prob;
                value-text: round(Rules.f-prob * 100) + "%";
                changed => {
                    Rules.form-changed();
                }
            }
        }
        TextField {
            width: 120px;
            label: "Приоритет";
            text <=> Rules.f-priority;
            error: Rules.e-priority;
            supporting: "больше — раньше";
            container-color: root.field-bg;
            edited => {
                Rules.form-changed();
            }
        }
        TextField {
            width: 180px;
            label: "Группа";
            text <=> Rules.f-group;
            supporting: "из группы — одно правило";
            container-color: root.field-bg;
            edited => {
                Rules.form-changed();
            }
        }
    }
    // one per row: side by side they outgrow the form on narrower panels
    VerticalLayout {
        spacing: Theme.sp2;
        alignment: start;
        Switch {
            text: "Можно пропустить ради точного времени";
            checked <=> Rules.f-optional;
            toggled => {
                Rules.form-changed();
            }
        }
        Switch {
            text: "Не вставлять в ручном режиме";
            checked <=> Rules.f-skipmanual;
            toggled => {
                Rules.form-changed();
            }
        }
    }
}
