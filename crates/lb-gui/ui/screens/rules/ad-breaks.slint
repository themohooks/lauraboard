// Ad break editor: list of breaks and the selected break's form.

import { ListView, ScrollView } from "std-widgets.slint";
import { Theme } from "../../theme/tokens.slint";
import { Icons } from "../../theme/icons.slint";
import { Label } from "../../components/label.slint";
import { TextField } from "../../components/text-field.slint";
import { Select } from "../../components/select.slint";
import { Button, ButtonVariant } from "../../components/button.slint";
import { IconButton } from "../../components/icon-button.slint";
import { ListRow } from "../../components/list-row.slint";
import { EmptyState } from "../../components/feedback.slint";
import { KindTag } from "../../components/indicators.slint";
import { Rules } from "../../state/rules-state.slint";
import { FormSection } from "form-parts.slint";
import { MediaPickList } from "media-list.slint";

export component AdBreaksEditor inherits HorizontalLayout {
    spacing: Theme.sp4;

    Rectangle {
        width: 300px;
        border-radius: Theme.radius-l;
        background: Theme.color.surface-container-low;
        VerticalLayout {
            padding: Theme.sp3;
            spacing: Theme.sp2;
            HorizontalLayout {
                Label {
                    horizontal-stretch: 1;
                    text: "Рекламные блоки";
                    type-style: Theme.title-medium;
                    vertical-alignment: center;
                }
                IconButton {
                    icon: Icons.add;
                    tooltip: "Новый рекламный блок";
                    clicked => {
                        Rules.break-add();
                    }
                }
            }
            if Rules.breaks.length == 0: EmptyState {
                vertical-stretch: 1;
                icon: Icons.campaign;
                title: "Нет рекламных блоков";
            }
            if Rules.breaks.length > 0: ListView {
                vertical-stretch: 1;
                for b[i] in Rules.breaks: ListRow {
                    radius: Theme.radius-full;
                    selected: Rules.break-selected == i;
                    focusable: false;
                    clicked => {
                        Rules.break-select(i);
                    }
                    Label {
                        horizontal-stretch: 1;
                        text: b;
                        color: Rules.break-selected == i ? Theme.color.on-secondary-container : Theme.color.on-surface;
                    }
                }
            }
        }
    }

    if Rules.break-selected < 0: EmptyState {
        horizontal-stretch: 1;
        icon: Icons.campaign;
        title: "Выберите рекламный блок";
        text: "Блок задаёт набор роликов, порядок и длительность. Правила и сетка ссылаются на него по id.";
    }
    if Rules.break-selected >= 0: sv := ScrollView {
        horizontal-stretch: 1;
        VerticalLayout {
            width: sv.visible-width;
            padding-top: Theme.sp2;
            spacing: Theme.sp3;
            padding-right: Theme.sp3;
            alignment: start;
            HorizontalLayout {
                spacing: Theme.sp3;
                TextField {
                    horizontal-stretch: 1;
                    label: "Название";
                    text <=> Rules.b-name;
                    supporting: "id: " + Rules.b-id;
                    edited => {
                        Rules.break-changed();
                    }
                }
                VerticalLayout {
                    alignment: start;
                    Button {
                        text: "Удалить блок";
                        variant: ButtonVariant.text;
                        icon: Icons.delete;
                        has-icon: true;
                        clicked => {
                            Rules.break-remove();
                        }
                    }
                }
            }
            FormSection {
                title: "Содержимое";
                icon: Icons.campaign;
                HorizontalLayout {
                    spacing: Theme.sp2;
                    Label {
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        text: Rules.b-media.length == 0 ? "Ролики не выбраны — в блок идут рекламные ролики категории"
                            : "Роликов: " + Rules.b-media.length;
                        color: Theme.color.on-surface-variant;
                        wrap: word-wrap;
                    }
                    if Rules.b-media.length > 0: Button {
                        text: "Очистить";
                        variant: ButtonVariant.text;
                        clicked => {
                            Rules.break-item("clear", 0);
                        }
                    }
                    Button {
                        text: "Выбрать из медиатеки";
                        variant: ButtonVariant.tonal;
                        icon: Icons.video-library;
                        has-icon: true;
                        clicked => {
                            Rules.pick("ad-items");
                        }
                    }
                }
                if Rules.b-media.length > 0: MediaPickList {
                    items: Rules.b-media;
                    remove-tooltip: "Убрать из блока";
                    action(a, i) => {
                        Rules.break-item(a, i);
                    }
                }
                HorizontalLayout {
                    spacing: Theme.sp3;
                    TextField {
                        horizontal-stretch: 1;
                        label: "Категория";
                        text <=> Rules.b-category;
                        edited => {
                            Rules.break-changed();
                        }
                    }
                    Select {
                        width: 220px;
                        label: "Порядок";
                        options: ["Как в списке", "Случайно", "Реже показанные"];
                        current-index <=> Rules.b-order;
                        selected => {
                            Rules.break-changed();
                        }
                    }
                }
            }
            FormSection {
                title: "Длительность";
                icon: Icons.timer;
                HorizontalLayout {
                    spacing: Theme.sp3;
                    TextField {
                        horizontal-stretch: 1;
                        label: "Целевая длительность";
                        text <=> Rules.b-duration;
                        error: Rules.e-b-duration;
                        placeholder: "00:03:00";
                        edited => {
                            Rules.break-changed();
                        }
                    }
                    TextField {
                        horizontal-stretch: 1;
                        label: "Максимум роликов";
                        text <=> Rules.b-max;
                        error: Rules.e-b-max;
                        edited => {
                            Rules.break-changed();
                        }
                    }
                    TextField {
                        horizontal-stretch: 1;
                        label: "Добивка (категория)";
                        text <=> Rules.b-fill;
                        supporting: "чем заполнить остаток";
                        edited => {
                            Rules.break-changed();
                        }
                    }
                }
            }
            FormSection {
                title: "Оформление";
                icon: Icons.animation;
                HorizontalLayout {
                    spacing: Theme.sp3;
                    TextField {
                        horizontal-stretch: 1;
                        label: "Заставка в начале";
                        text <=> Rules.b-intro;
                        placeholder: "нет";
                        edited => {
                            Rules.break-changed();
                        }
                    }
                    VerticalLayout {
                        alignment: start;
                        padding-top: 4px;
                        IconButton {
                            icon: Icons.video-library;
                            tooltip: "Выбрать из медиатеки";
                            clicked => {
                                Rules.pick("ad-intro");
                            }
                        }
                    }
                    TextField {
                        horizontal-stretch: 1;
                        label: "Заставка в конце";
                        text <=> Rules.b-outro;
                        placeholder: "нет";
                        edited => {
                            Rules.break-changed();
                        }
                    }
                    VerticalLayout {
                        alignment: start;
                        padding-top: 4px;
                        IconButton {
                            icon: Icons.video-library;
                            tooltip: "Выбрать из медиатеки";
                            clicked => {
                                Rules.pick("ad-outro");
                            }
                        }
                    }
                }
            }
            if Rules.b-used-by.length > 0: FormSection {
                title: "Используется";
                icon: Icons.account-tree;
                for u in Rules.b-used-by: Label {
                    text: u;
                    type-style: Theme.body-small;
                }
            }
        }
    }
}
