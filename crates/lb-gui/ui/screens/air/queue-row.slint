// One rundown row: start time, kind, title, block, duration; the item on
// air gets the live accent bar, the next one a preview marker.

import { Theme } from "../../theme/tokens.slint";
import { Icons } from "../../theme/icons.slint";
import { Label } from "../../components/label.slint";
import { Icon } from "../../components/icon.slint";
import { ListRow } from "../../components/list-row.slint";
import { Kinds } from "../../components/indicators.slint";
import { Menu } from "../../components/menu.slint";
import { Air, QueueRow } from "../../state/air-state.slint";

export component QueueRowView inherits ListRow {
    in property <QueueRow> item;
    in property <bool> show-block: true;
    height: Theme.dense(52px, 72px);

    current: item.current;
    accent: Theme.status.live;
    divider: item.block-start;
    accessible-label: item.start + " " + item.title;
    right-clicked(p) => {
        // the menu sits at the end of the row's layout while p is row-local
        menu.open-at(p.x - menu.x, p.y - menu.y);
    }

    Label {
        width: 64px;
        text: root.item.start;
        mono: true;
        type-style: Theme.body-small;
        color: root.item.block-start ? Theme.color.on-surface : Theme.color.on-surface-variant;
        font-weight: root.item.block-start ? 600 : 400;
    }
    VerticalLayout {
        alignment: center;
        Icon {
            source: Kinds.icon-of(root.item.kind);
            size: 16px;
            tint: root.item.current ? Theme.status.live : root.item.next ? Theme.status.preview : Kinds.color-of(root.item.kind);
        }
    }
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        Label {
            text: root.item.kind == "gap" ? "Пустота — нет материала" : root.item.title;
            type-style: root.item.main ? Theme.label-large : Theme.body-medium;
            color: root.item.kind == "gap" ? Theme.color.error : Theme.color.on-surface;
        }
        Label {
            text: (root.item.current ? "● В эфире · " : root.item.next ? "Следующий · " : "") + Kinds.name-of(root.item.kind);
            type-style: Theme.label-small;
            color: Kinds.color-of(root.item.kind);
        }
        if root.item.note != "" && Theme.compact == false: Label {
            text: root.item.note;
            type-style: Theme.label-small;
            color: Theme.color.on-surface-variant;
        }
    }
    if root.show-block: Label {
        width: 110px;
        text: root.item.block;
        type-style: Theme.body-small;
        color: Theme.color.on-surface-variant;
    }
    Label {
        width: 64px;
        text: root.item.duration;
        mono: true;
        type-style: Theme.body-small;
        horizontal-alignment: right;
        color: Theme.color.on-surface-variant;
    }

    menu := Menu {
        menu-width: 260px;
        entries: root.item.current ? [
            { id: "skip", text: "Пропустить…", icon: Icons.skip-next, has-icon: true, enabled: true },
            { id: "restart", text: "Начать заново…", icon: Icons.replay, has-icon: true, enabled: root.item.media != "" },
            { id: "queue-again", text: "Повторить после текущего", icon: Icons.queue-music, has-icon: true, enabled: root.item.media != "", divider: true },
            { id: "video-edit", text: "Монтаж…", icon: Icons.movie, has-icon: true, enabled: root.item.media != "" && root.item.kind != "image" && root.item.kind != "stream" },
            { id: "details", text: "Подробности", icon: Icons.info, has-icon: true, enabled: true, divider: true },
        ] : [
            { id: "play-item", text: "Запустить досрочно…", icon: Icons.play-arrow, has-icon: true, enabled: root.item.kind != "gap" },
            { id: "queue-again", text: "Добавить в очередь после текущего", icon: Icons.queue-music, has-icon: true, enabled: root.item.media != "", divider: true },
            { id: "video-edit", text: "Монтаж…", icon: Icons.movie, has-icon: true, enabled: root.item.media != "" && root.item.kind != "image" && root.item.kind != "stream" },
            { id: "details", text: "Подробности", icon: Icons.info, has-icon: true, enabled: true, divider: true },
        ];
        activated(id) => {
            Air.queue-action(root.item.uid, id);
        }
    }
}
