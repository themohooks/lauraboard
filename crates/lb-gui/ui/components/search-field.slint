// Compact M3 search bar: pill on surface-container-high, search icon,
// clear button. `focus-input()` is bound to Ctrl+F by the screens.

import { Theme } from "../theme/tokens.slint";
import { Icons } from "../theme/icons.slint";
import { Icon } from "icon.slint";
import { Label } from "label.slint";
import { IconButton } from "icon-button.slint";

export component SearchField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder: "Поиск";
    out property <bool> has-focus: input.has-focus;
    callback edited(string);

    public function focus-input() {
        input.focus();
    }

    height: Theme.control-height;
    min-width: 160px;
    border-radius: self.height / 2;
    background: Theme.color.surface-container-high;
    border-width: root.has-focus ? 2px : 0;
    border-color: root.has-focus ? Theme.color.primary : Theme.color.primary.with-alpha(0);
    animate border-width, border-color { duration: Theme.motion-short; easing: ease-out; }
    accessible-role: text-input;
    accessible-label: root.placeholder;
    accessible-value: root.text;

    TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => {
            input.focus();
        }
    }

    HorizontalLayout {
        padding-left: Theme.sp3;
        padding-right: Theme.sp1;
        spacing: Theme.sp2;
        VerticalLayout {
            alignment: center;
            Icon {
                source: Icons.search;
                size: Theme.icon-small;
            }
        }
        Rectangle {
            min-width: 0px;
            clip: true;
            horizontal-stretch: 1;
            if root.text == "": Label {
                width: 100%;
                text: root.placeholder;
                color: Theme.color.on-surface-variant;
            }
            input := TextInput {
                width: 100%;
                height: 100%;
                text <=> root.text;
                single-line: true;
                vertical-alignment: center;
                font-size: Theme.body-medium.size;
                color: Theme.color.on-surface;
                selection-background-color: Theme.color.primary-container;
                selection-foreground-color: Theme.color.on-primary-container;
                edited => {
                    root.edited(self.text);
                }
                key-pressed(e) => {
                    if e.text == Key.Escape && self.text != "" {
                        self.text = "";
                        root.edited("");
                        return accept;
                    }
                    reject
                }
            }
        }
        if root.text != "": IconButton {
            y: (parent.height - self.height) / 2;
            width: Theme.control-height - 8px;
            height: Theme.control-height - 8px;
            icon: Icons.close;
            tooltip: "Очистить";
            focusable: false;
            clicked => {
                root.text = "";
                root.edited("");
            }
        }
    }
}
