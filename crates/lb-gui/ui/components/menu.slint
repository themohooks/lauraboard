// M3 menu used for overflow (⋮) and context menus. Entries come from a
// model; `open-at(x, y)` shows it at a point relative to the Menu element
// (place the Menu in the element that receives the click).

import { Theme } from "../theme/tokens.slint";
import { Icon } from "icon.slint";
import { Label } from "label.slint";
import { Interactive } from "interactive.slint";

export struct MenuEntry {
    id: string,
    text: string,
    icon: image,
    has-icon: bool,
    shortcut: string,
    danger: bool,
    enabled: bool,
    // thin divider above this entry
    divider: bool,
    // small chip after the text ("НЕСТАБИЛЬНО")
    badge: string,
}

// Size of the window, set by the app: menus stay inside it.
export global MenuBounds {
    in-out property <length> width: 100000px;
    in-out property <length> height: 100000px;
}

export component Menu {
    in property <[MenuEntry]> entries;
    in property <length> menu-width: 240px;
    callback activated(string);

    property <length> px;
    property <length> py;
    property <length> item-height: Theme.dense(36px, 44px);

    public function open-at(x: length, y: length) {
        root.px = x;
        root.py = y;
        popup.show();
    }

    width: 0;
    height: 0;

    // flipped to the left of / above the point when there is no room
    popup := PopupWindow {
        x: root.absolute-position.x + root.px + root.menu-width + 8px > MenuBounds.width
            ? max(8px - root.absolute-position.x, root.px - root.menu-width) : root.px;
        y: root.absolute-position.y + root.py + content.preferred-height + 8px > MenuBounds.height
            ? max(8px - root.absolute-position.y, root.py - content.preferred-height) : root.py;
        width: root.menu-width;
        content := Rectangle {
            // created on every show(): fade in from init. No `y` here: an
            // explicit position drops the popup's implicit height (no
            // background, entries outside the popup and not clickable).
            property <bool> appeared;
            init => {
                self.appeared = true;
            }
            opacity: appeared ? 1 : 0;
            animate opacity { duration: Theme.motion-medium; easing: ease-out; }
            background: Theme.color.surface-container;
            border-radius: Theme.radius-xs;
            drop-shadow-blur: 8px;
            drop-shadow-offset-y: 3px;
            drop-shadow-color: Theme.color.shadow.with-alpha(Theme.dark ? 0.5 : 0.2);
            VerticalLayout {
                padding-top: Theme.sp2;
                padding-bottom: Theme.sp2;
                for e in root.entries: VerticalLayout {
                    if e.divider: Rectangle {
                        height: 9px;
                        Rectangle {
                            height: 1px;
                            background: Theme.color.outline-variant;
                        }
                    }
                    Interactive {
                        height: root.item-height;
                        radius: 0;
                        focusable: false;
                        enabled: e.enabled;
                        accessible-role: button;
                        accessible-label: e.text;
                        clicked => {
                            // before close(): closing destroys this row and `e`
                            root.activated(e.id);
                            popup.close();
                        }
                        HorizontalLayout {
                            padding-left: Theme.sp3;
                            padding-right: Theme.sp3;
                            spacing: Theme.sp3;
                            VerticalLayout {
                                alignment: center;
                                Icon {
                                    source: e.icon;
                                    opacity: e.has-icon ? 1 : 0;
                                    tint: !e.enabled ? Theme.color.on-surface.with-alpha(Theme.disabled-content)
                                        : e.danger ? Theme.color.error : Theme.color.on-surface-variant;
                                }
                            }
                            Label {
                                horizontal-stretch: 1;
                                text: e.text;
                                type-style: Theme.label-large;
                                color: !e.enabled ? Theme.color.on-surface.with-alpha(Theme.disabled-content)
                                    : e.danger ? Theme.color.error : Theme.color.on-surface;
                            }
                            if e.badge != "": VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    height: 18px;
                                    width: badge-text.preferred-width + 12px;
                                    border-radius: 9px;
                                    background: Theme.color.error-container;
                                    badge-text := Label {
                                        text: e.badge;
                                        type-style: Theme.label-small;
                                        color: Theme.color.on-error-container;
                                        horizontal-alignment: center;
                                    }
                                }
                            }
                            if e.shortcut != "": Label {
                                text: e.shortcut;
                                type-style: Theme.label-medium;
                                color: Theme.color.on-surface-variant;
                            }
                        }
                    }
                }
            }
        }
    }
}
