import { ScrollingInput } from "scrolling-input.slint";
// M3 outlined text field (dense desktop variant): the label sits on the
// border, placeholder inside, supporting or error text below. An error
// turns the outline and label red and adds an error icon, so the state is
// never shown by color alone.

import { Theme } from "../theme/tokens.slint";
import { Icons } from "../theme/icons.slint";
import { Icon } from "icon.slint";
import { Label } from "label.slint";

export component TextField inherits VerticalLayout {
    in property <string> label;
    in-out property <string> text;
    in property <string> placeholder;
    in property <string> supporting;
    in property <string> error;
    in property <bool> enabled: true;
    in property <bool> read-only: false;
    in property <image> leading-icon;
    in property <bool> has-leading: false;
    in property <string> suffix;
    in property <bool> mono: false;
    in property <InputType> input-type: InputType.text;
    in property <color> container-color: Theme.color.surface;
    out property <bool> has-focus: input.has-focus;
    callback edited(string);
    callback accepted(string);

    public function focus-input() {
        input.focus();
    }

    property <bool> invalid: error != "";
    property <color> accent: invalid ? Theme.color.error : Theme.color.primary;

    spacing: Theme.sp1;
    min-width: 96px;

    box := Rectangle {
        height: Theme.control-height + Theme.dense(0px, 8px);
        border-radius: Theme.radius-xs;
        border-width: (root.has-focus || root.invalid) && root.enabled ? 2px : 1px;
        border-color: !root.enabled ? Theme.color.on-surface.with-alpha(Theme.disabled-container)
            : root.invalid ? Theme.color.error
            : root.has-focus ? Theme.color.primary
            : touch.has-hover ? Theme.color.on-surface
            : Theme.color.outline;
        // a faint tint while focused; every state change eases in
        background: root.has-focus && root.enabled ? root.accent.with-alpha(Theme.dark ? 0.06 : 0.04) : transparent;
        animate border-color, background { duration: Theme.motion-short; easing: ease-out; }
        animate border-width { duration: Theme.motion-short; }
        accessible-role: text-input;
        accessible-label: root.label;
        accessible-value: root.text;
        accessible-description: root.invalid ? root.error : root.supporting;

        touch := TouchArea {
            mouse-cursor: MouseCursor.text;
            clicked => {
                input.focus();
            }
        }

        HorizontalLayout {
            padding-left: root.has-leading ? Theme.sp3 : Theme.sp4;
            padding-right: Theme.sp3;
            spacing: Theme.sp2;
            if root.has-leading: VerticalLayout {
                alignment: center;
                Icon {
                    source: root.leading-icon;
                    size: Theme.icon-small;
                }
            }
            Rectangle {
                min-width: 0px;
                clip: true;
                horizontal-stretch: 1;
                if root.text == "": Label {
                    width: 100%;
                    text: root.placeholder;
                    type-style: Theme.body-large;
                    color: Theme.color.on-surface-variant.with-alpha(0.7);
                    // fades and slides aside on focus instead of vanishing
                    opacity: root.has-focus ? 0 : 1;
                    x: root.has-focus ? 8px : 0;
                    animate opacity, x { duration: Theme.motion-short; easing: ease-out; }
                }
                input := ScrollingInput {
                    viewport-width: parent.width;
                    text <=> root.text;
                    enabled: root.enabled;
                    read-only: root.read-only;
                    input-type: root.input-type;
                    single-line: true;
                    vertical-alignment: center;
                    font-size: Theme.body-large.size;
                    font-family: root.mono ? Theme.mono-font : Theme.font;
                    color: root.enabled ? Theme.color.on-surface : Theme.color.on-surface.with-alpha(Theme.disabled-content);
                    selection-background-color: Theme.color.primary-container;
                    selection-foreground-color: Theme.color.on-primary-container;
                    edited => {
                        root.edited(self.text);
                    }
                    accepted => {
                        root.accepted(self.text);
                    }
                }
            }
            if root.suffix != "": Label {
                text: root.suffix;
                type-style: Theme.body-medium;
                color: Theme.color.on-surface-variant;
            }
            if root.invalid: VerticalLayout {
                alignment: center;
                Icon {
                    source: Icons.error;
                    size: Theme.icon-small;
                    tint: Theme.color.error;
                }
            }
        }

        if root.label != "": Rectangle {
            x: Theme.sp3 - 4px;
            y: -label-text.preferred-height / 2;
            width: label-text.preferred-width + 8px;
            height: label-text.preferred-height;
            background: root.container-color;
            label-text := Label {
                text: root.label;
                type-style: Theme.body-small;
                color: !root.enabled ? Theme.color.on-surface.with-alpha(Theme.disabled-content)
                    : root.invalid || root.has-focus ? root.accent : Theme.color.on-surface-variant;
                animate color { duration: Theme.motion-short; }
            }
        }
    }

    if root.invalid || root.supporting != "": Label {
        x: Theme.sp4;
        text: root.invalid ? root.error : root.supporting;
        type-style: Theme.body-small;
        color: root.invalid ? Theme.color.error : Theme.color.on-surface-variant;
        animate color { duration: Theme.motion-short; }
        wrap: word-wrap;
        overflow: clip;
    }
}
