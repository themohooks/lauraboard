<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lauraboard.android.experimental"
    android:versionCode="2001" android:versionName="0.2.0-debug">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:label="LauraBoard Experimental" android:hasCode="false"
        android:debuggable="true" android:usesCleartextTraffic="true"
        android:extractNativeLibs="true" android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name="android.app.NativeActivity" android:exported="true"
            android:screenOrientation="landscape" android:launchMode="singleTop"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:windowSoftInputMode="adjustResize">
            <meta-data android:name="android.app.lib_name" android:value="lb_android" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
