// Where to install.

import { Theme } from "@m3/theme/tokens.slint";
import { Icons } from "@m3/theme/icons.slint";
import { Card } from "@m3/components/card.slint";
import { Label } from "@m3/components/label.slint";
import { Button, ButtonVariant } from "@m3/components/button.slint";
import { StatusChip, StatusTone } from "@m3/components/indicators.slint";
import { TextField } from "@m3/components/text-field.slint";
import { Setup } from "../state.slint";
import { WizardPage } from "../parts/page.slint";
import { ScopeRow } from "../parts/scope-row.slint";

export component LocationPage inherits WizardPage {
    title: "Папка установки";
    text: "Для кого ставится программа и в какую папку.";

    Card {
        card-style: low;
        inset: Theme.sp2;
        gap: 0;
        ScopeRow {
            icon: Icons.person;
            title: "Только для меня";
            text: "Права администратора не нужны. Ярлыки и команда lauraboard — только в вашей учётной записи.";
            checked: !Setup.all-users;
            clicked => {
                Setup.all-users = false;
                Setup.scope-changed();
            }
        }
        ScopeRow {
            icon: Icons.group;
            title: "Для всех пользователей компьютера";
            text: Setup.windows
                ? "Нужны права администратора (Windows спросит разрешение). Папка в Program Files, ярлыки и PATH — общие."
                : "Нужны права root (запустите установщик через sudo). Папка в /opt, значок в меню и команда lauraboard — для всех.";
            checked: Setup.all-users;
            clicked => {
                Setup.all-users = true;
                Setup.scope-changed();
            }
        }
    }

    HorizontalLayout {
        spacing: Theme.sp2;
        TextField {
            label: "Папка";
            text <=> Setup.install-dir;
            leading-icon: Icons.folder-open;
            has-leading: true;
            error: Setup.dir-error;
            supporting: Setup.dir-note;
            horizontal-stretch: 1;
            edited(t) => {
                Setup.dir-edited(t);
            }
        }
        VerticalLayout {
            alignment: start;
            padding-top: 4px;
            Button {
                text: "Обзор…";
                variant: ButtonVariant.outlined;
                clicked => {
                    Setup.browse-dir();
                }
            }
        }
    }

    HorizontalLayout {
        spacing: Theme.sp2;
        alignment: start;
        StatusChip {
            tone: StatusTone.info;
            icon: Icons.download;
            text: "Нужно места: \{Setup.size-text}";
        }
    }

    Card {
        card-style: low;
        Label {
            text: "Что будет в папке";
            type-style: Theme.title-small;
        }
        Label {
            text: Setup.windows
                ? "lauraboard.exe — программа (графический интерфейс и команды), uninstall.exe — удаление, документация. Проекты каналов хранятся отдельно, по умолчанию в «Документы\\LauraBoard»."
                : "lauraboard — программа (графический интерфейс и команды), uninstall — удаление, документация. Проекты каналов хранятся отдельно, по умолчанию в ~/Documents/LauraBoard.";
            type-style: Theme.body-medium;
            color: Theme.color.on-surface-variant;
            wrap: word-wrap;
            overflow: clip;
        }
    }
}
